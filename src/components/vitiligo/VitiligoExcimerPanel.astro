    /* ExpandCardRow 의 호버 라벨 규칙(흰색)은 compound 마다 스코프 속성이 붙어 특이도가
       (0,10,0) 이라 이 파일 선택자로는 동률까지가 한계다. about §5 가 같은 이유로 쓴
       !important 선례를 따른다(VitiligoAboutPanel .vta-s5-wrap 호버 라벨 주석 참조). */
    .vte-device-row
      :global(.ecr-row.ecr-fill:not(.ecr-pinlock.has-open):not(.is-hover-locked) .ecr-cell:hover .ecr-name) {
      color: var(--color-ink) !important;
    }
  }

  .vte-duration {
