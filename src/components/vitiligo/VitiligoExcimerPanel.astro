<script>
  import { syncDisclosureState } from './about/disclosureState.mjs';

  document.querySelectorAll<HTMLElement>('.vte').forEach((root) => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const accordion = root.querySelector<HTMLElement>('[data-vte-accordion]');
    if (accordion) {
      const items = Array.from(accordion.querySelectorAll<HTMLLIElement>(':scope > li'));
      const setOpen = (item: HTMLLIElement, open: boolean) => {
        item.classList.toggle('is-open', open);
        const trigger = item.querySelector<HTMLButtonElement>('[data-vte-acc-trigger]');
        const panel = item.querySelector<HTMLElement>('[data-vte-acc-panel]');
        if (trigger && panel) syncDisclosureState(trigger, panel, open);
      };

      items.forEach((item) => setOpen(item, false));
      void accordion.offsetHeight;
      accordion.classList.add('is-ready');
      items.forEach((item) => {
        item.querySelector<HTMLButtonElement>('[data-vte-acc-trigger]')?.addEventListener('click', () => {
          const willOpen = !item.classList.contains('is-open');
          items.forEach((other) => setOpen(other, other === item && willOpen));
        });
      });
    }

    if (!reducedMotion.matches && 'IntersectionObserver' in window) {
      root.classList.add('vte-reveal-ready');
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
      );
      root.querySelectorAll<HTMLElement>('[data-vte-reveal]').forEach((element) => revealObserver.observe(element));

      const counters = Array.from(root.querySelectorAll<HTMLElement>('[data-vte-count]'));
      const counterObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const element = entry.target as HTMLElement;
            const target = Number(element.dataset.target ?? 0);
            const suffix = element.dataset.suffix ?? '';
            const duration = 1300;
            const startedAt = performance.now();
            const render = (now: number) => {
              const progress = Math.min(1, (now - startedAt) / duration);
              const eased = 1 - Math.pow(1 - progress, 3);
              element.textContent = `${(target * eased).toFixed(1)}${suffix}`;
              if (progress < 1) requestAnimationFrame(render);
            };
            element.textContent = `0.0${suffix}`;
            requestAnimationFrame(render);
            counterObserver.unobserve(element);
          });
        },
        { threshold: 0.5 },
      );
      counters.forEach((counter) => counterObserver.observe(counter));
    }
  });
</script>
