    color: #FFFFFF;
    font-size: 36px;
    font-weight: 600;
    line-height: 54px;
    letter-spacing: -0.02em;
  }
  .vte-team header p {
    margin: 30px 0 0;
    color: rgb(255 255 255 / 0.5);
    font-size: 16px;
    line-height: 28px;
    word-break: keep-all;
  }
  .vte-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
  }
  .vte-stat {
    display: flex;
    min-height: 180px;
    flex-direction: column;
    justify-content: center;
    padding-left: 20px;
    /* 원장 지시 2026-08-07 §6-1 — 세로선 #A5D8F0(숫자 색과 같은 톤) */
    border-left: 3px solid #A5D8F0;
  }
  .vte-stat dt {
    min-height: 60px;
    margin: 0;
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 400;
    line-height: 30px;
