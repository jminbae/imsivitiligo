---
import { localeOf, localeUrl } from '../../lib/i18n';
/* 이 페이지의 언어. 메뉴 데이터가 프론트매터 앞쪽에 있어 **맨 위**에 둔다.
   'ko' 를 박지 않는다 — 2단계에서 언어가 늘어도 이 파일은 손대지 않는다. 정본: src/lib/i18n.ts */
const lang = localeOf(Astro.currentLocale);
/**
 * VitiligoExcimerPanel — /vitiligo/excimer/ 전용 편집형 본문.
 * 섹션 1~6은 승인 시안(260806-백반증_엑시머클리닉)을 따르고,
 * 섹션 7은 주분류별 칼럼 질문·즉답을 공용 FAQ로 연결한다.
 */
import VitiligoRelatedColumns from './VitiligoRelatedColumns.astro';
import ExpandCardRow from '../ui/ExpandCardRow.astro';
import PagingIndicator from '../ui/PagingIndicator.astro';
import type { VitiligoSection } from '../../lib/types';

interface Props {
  section: VitiligoSection;
  initial: boolean;
}

const { section, initial } = Astro.props;

const IMG = '/images/vitiligo/excimer';

const STEPS = [
  {
    image: `${IMG}/mechanism-1.webp`,
    title: '자외선이 피부에 닿음',
    description: '병변 부위에 치료에 필요한 자외선이 닿습니다.',
  },
  {
    image: `${IMG}/mechanism-2.webp`,
    title: '색소세포가 깨어남',
    description: '표피의 신호가 모낭의 색소세포 활성화와 이동을 돕습니다.',
  },
  {
    image: `${IMG}/mechanism-3.webp`,
    title: '색소가 다시 자리 잡음',
    description: '이동한 색소세포가 병변에 자리 잡으며 색이 돌아옵니다.',
  },
] as const;

/* 장비 문안·명칭은 **원장이 직접 다시 쓴 것**이다(2026-08-08 "멘트 이렇게 다 바꿔줘. 내가 새로 썼어").
   임의로 다듬거나 옛 문안으로 되돌리지 말 것 — 의료 문안이라 표현 하나가 광고 심의 대상이다.
   ⚠️ device-2 는 종전 이름이 '상반신 광선기기'였으나 사진은 얼굴·목을 덮는 기기다(실물 확인).
      원장이 '얼굴 광선치료기'로 바로잡은 것이라 사진 교체가 필요 없다.
      다만 equipment.json 의 같은 장비는 아직 '상반신 광선치료기'로 남아 있다(지점 장비 목록용) —
      이 페이지만 고친 것이므로 DB 명칭을 함께 바꿀지는 원장 결정 사항이다. */
const DEVICES = [
  {
    image: `${IMG}/device-1.webp`,
    name: '전신 광선치료기',
    desc: '좁은파장 자외선B(311nm)를 전신에 조사해 백반증의 자가면역 반응을 억제하고, 멜라닌세포의 증식과 이동을 자극합니다. 몸 전체에 넓게 퍼진 병변에 효과적입니다.',
  },
  {
    image: `${IMG}/device-2.webp`,
    name: '얼굴 광선치료기',
    desc: '좁은파장 자외선B를 얼굴과 목에만 선택적으로 조사합니다. 얼굴에 넓게 번지는 활동성 백반증의 자가면역 반응을 억제하여 빠른 색소회복을 유도합니다.',
  },
  {
    image: `${IMG}/device-3.webp`,
    name: '손발 광선기기',
    desc: '손과 발의 병변에 자외선을 집중 조사합니다. 손발은 각질층이 두껍고 모낭이 적어 반응이 더딘 부위인 만큼, 전체적으로 충분한 에너지를 전달하면서 꾸준히 치료를 이어가는 것이 중요합니다.',
  },
  {
    image: `${IMG}/device-4.webp`,
    name: '엑시머 레이저',
    desc: '308nm 레이저를 병변에만 조준해 정상 피부의 불필요한 자외선 노출을 최소화합니다. 좁은 범위에 높은 에너지를 집중하므로 반응이 빠르게 나타나며, 눈가나 입술 주변처럼 좁은 부위도 정밀하게 치료할 수 있습니다.',
  },
  {
    image: `${IMG}/device-5.webp`,
    name: '팔라스 프리미엄',
    desc: '국내에서 처음 개발된 311nm 티타늄사파이어 레이저로, 백반증 병변에만 고출력으로 집중 조사합니다. 엑시머 레이저와 함께 병변만 겨냥하는 표적 치료 장비로, 병변의 위치와 범위에 따라 선택해 사용합니다.',
  },
  {
    image: `${IMG}/device-6.webp`,
    name: 'UVA1 광선치료기',
    desc: '340~400nm 장파장 자외선A로, 표피를 지나 진피 깊은 층까지 도달합니다. 자외선B가 닿기 어려운 깊이의 멜라닌세포까지 자극해 색소 침착을 유도합니다.',
  },
] as const;
---

<div class:list={['vte', initial && 'animate-fade-up']}>
  <section class="vte-section vte-intro bleed" data-vte-section="1">
    <div class="wrapper--content vte-container vte-pad">
      <header class="vte-intro-head" data-vte-reveal>
        <div>
          <p class="vte-kicker">힐하우스피부과 엑시머 클리닉</p>
          <h2 class="vte-title vte-title--large">
            빛으로 되살리는 피부 색소<br />
            백반증 광선치료
          </h2>
        </div>
        <p class="vte-body vte-intro-copy vt-left-copy">
          백반증 광선치료란, 백반증 치료에 유효한 특정 자외선만을 조사해 멜라닌세포의 증식과 이동을 촉진하는 치료입니다. 좁은띠자외선(NBUVB), 엑시머, 팔라스 레이저 등을 활용하여 색소 재생을 유도하는 가장 표준적인 치료법입니다.
        </p>
      </header>
      {/* 사진 고정(원장 지시 2026-08-07 §1-3 "박스 안 사진은 스크롤에 따라 이동하지 않도록 고정") —
          '백반증이란' §2(.vta-s2)와 같은 background-attachment: fixed 관용구. img 로는 낼 수 없는
          연출이라 배경 이미지 + role="img"/aria-label 로 대체하고 대체텍스트를 유지한다.
          터치·모션축소 환경은 scroll 유지(iOS fixed 배경 깨짐 회피 — vta-s2 주석과 동일 근거). */}
      <div
        class="vte-hero"
        data-vte-reveal
        style={`--vte-delay: 80ms; background-image: url('${IMG}/04-1_엑시머클리닉.png')`}
        role="img"
        aria-label="백반증 광선치료를 상징하는 빛"
      >
      </div>
    </div>
  </section>

  <section class="vte-section vte-mechanism bleed" data-vte-section="2">
    <div class="wrapper--content vte-container vte-pad">
      <header class="vte-centered" data-vte-reveal>
        <p class="vte-kicker">힐하우스피부과 엑시머 클리닉</p>
        <h2 class="vte-title">색소가 되살아나는<span class="vte-mobile-break"></span> 광선치료 메커니즘</h2>
        <p class="vte-body vte-lead">
          특정 자외선이 모낭을 자극해 멜라닌 색소세포의 활성화와 이동을 유도합니다.<br />
          이동한 색소가 백반증 부위에 정착하면서 자연스럽게 피부 색이 복원됩니다.
        </p>
      </header>

      <ol class="vte-step-grid" aria-label="광선치료 메커니즘 3단계">
        {
          STEPS.map((step, index) => (
            <li data-vte-reveal style={`--vte-delay: ${index * 80}ms`}>
              <figure>
                <img
                  src={step.image}
                  alt={step.title}
                  width="856"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <p class="vte-step-label">STEP {index + 1}</p>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
              {index < STEPS.length - 1 && (
                <img
                  class="vte-step-arrow"
                  src={`${IMG}/arrow-step.svg`}
                  alt=""
                  width="24"
                  height="24"
                  aria-hidden="true"
                />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="vte-section vte-devices bleed" data-vte-section="3">
    <div class="wrapper--content vte-container vte-pad">
      <header class="vte-centered" data-vte-reveal>
        <p class="vte-kicker">힐하우스피부과 엑시머 클리닉</p>
        <h2 class="vte-title">광선치료의<span class="vte-mobile-break"></span> 종류 및 권장대상</h2>
        <div class="vte-nbuvb">
          <h3>좁은띠 자외선치료 (NBUVB)</h3>
          {/* 원장 지시 2026-08-08 — '부작용 부담이 적어 … 소아나 임신·수유부도 안전하게 고려할 수
              있습니다.' 한 줄 삭제. 되살리지 말 것. 이에 따라 <br /> 도 함께 걷어냈다. */}
          <p>넓은 부위의 병변을 한 번에 치료하고 번짐을 막아주는 표준 치료법입니다. (주 2회)</p>
        </div>
      </header>

      {/* 개수는 DEVICES 에서 파생한다 — 손으로 '5종'이라 적어 두면 장비가 늘 때 조용히 어긋난다
          (실제로 UVA1 을 더할 때 이 라벨만 5종으로 남아 있었다). */}
      <div
        class="vte-device-row"
        aria-label={`광선치료 기기 ${DEVICES.length}종`}
        data-vte-reveal
        style={`--vte-delay: 60ms; --vte-card-n: ${DEVICES.length}`}
      >
        {/* 부제 TYPE 01~ (원장 지시 2026-08-07 §3-1) — 카드 순번. 색은 eyebrowColor 로 전달 */}
        <ExpandCardRow
          cards={DEVICES.map((device, index) => ({
            src: device.image,
            alt: `${device.name} 장비`,
            width: 528,
            height: 720,
            eyebrow: `TYPE 0${index + 1}`,
            title: device.name,
            body: device.desc,
            label: device.name,
          }))}
          variant="fill"
          eyebrowColor="#97C0DF"
          bleed
          marquee
          pinHover
        />
      </div>
    </div>
  </section>

  <section class="vte-section vte-duration bleed" data-vte-section="4">
    <div class="wrapper--content vte-container vte-pad">
      <div class="vte-duration-head">
        <header data-vte-reveal>
          <p class="vte-kicker">힐하우스피부과 엑시머 클리닉</p>
          <h2 class="vte-title">
            꾸준함이 만드는 변화,<br />
            치료 기간과 경과
          </h2>
          <p class="vte-body vte-duration-copy vt-left-copy">
            <span>광선치료는 꾸준함이 중요한 치료입니다.</span>
            <span>대개 6개월에서 1년가량 꾸준히 치료하며, 부위에 따라 반응 속도가 다릅니다.</span>
            <span>적어도 3개월 이상 치료해 보아야 반응을 가늠할 수 있습니다.</span>
            <span>색소는 모낭 주위, 병변 가장자리, 또는 병변 전반에 걸쳐 조금씩 돌아오는 것으로 관찰됩니다.</span>
            <span>반응은 부위와 개인에 따라 달라, 경과를 보며 계획을 조율합니다.</span>
          </p>
        </header>

        <aside class="vte-notice" data-vte-reveal style="--vte-delay: 80ms">
          <div class="vte-notice-title">
            <img src={`${IMG}/notice-blue.svg`} alt="" width="28" height="28" aria-hidden="true" />
            <h3>치료 전 알아두기</h3>
          </div>
          <p>
            광선치료의 안전성은 대체로 잘 알려져 있으나, 장기간 누적 조사와 관련한 주의가 보고되기도 합니다. 소아이거나 임신 중이라면 진료 시 미리 알려 주시면 그에 맞춰 계획합니다.
          </p>
        </aside>
      </div>

      <div id="vte-before-after" class="vte-ba-grid" aria-label="광선치료 전후 사진" tabindex="0">
        {
          [1, 2, 3, 4, 5, 6].map((n, index) => (
            <figure class="vte-ba-set" data-vte-ba-slide data-vte-reveal style={`--vte-delay: ${(index % 2) * 80}ms`}>
              <div class="vte-ba-pair">
                <img
                  class="vte-ba-image"
                  src={`${IMG}/ba-0${n}-before.jpg`}
                  alt={`광선치료 전 ${n}`}
                  width="345"
                  height="240"
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="vte-ba-image"
                  src={`${IMG}/ba-0${n}-after.jpg`}
                  alt={`광선치료 후 ${n}`}
                  width="345"
                  height="240"
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="vte-ba-arrow"
                  src={`${IMG}/arrow-before-after.svg`}
                  alt=""
                  width="44"
                  height="44"
                  aria-hidden="true"
                />
              </div>
              <figcaption class="sr-only">광선치료 전후 비교 {n}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="vte-ba-pager">
        <PagingIndicator total={6} scrollRailId="vte-before-after" slideSelector="[data-vte-ba-slide]" scrollByPage previousLabel="이전 전후 사진 보기" nextLabel="다음 전후 사진 보기" ariaLabel="광선치료 전후 사진 탐색" />
      </div>
    </div>
  </section>

  <section class="vte-section vte-response bleed" aria-labelledby="vte-response-title">
    <div class="wrapper--content vte-container vte-pad vte-response-inner">
      <header data-vte-reveal>
        <p class="vte-kicker">Response Check</p>
        <h2 id="vte-response-title" class="vte-title vte-added-title">치료 반응은<br />부위마다 다르게 나타납니다</h2>
        <p class="vte-body">얼굴과 목은 비교적 반응을 기대하기 쉬운 편이지만, 손끝·발끝처럼 모낭이 적은 부위는 더 오랜 시간이 필요하거나 반응이 제한적일 수 있습니다.</p>
      </header>
      <div class="vte-response-copy">
        <p class="vte-response-lede" data-vte-reveal>반응이 적어 보일 때에는 치료를 바로 포기하기보다 다음 네 가지를 차례로 점검합니다.</p>
        <ol>
          <li data-vte-reveal><span aria-hidden="true">01</span><div><h3>사진으로 실제 변화를 비교합니다</h3><p>같은 조건의 사진에서 병변 경계와 모낭 주변 색소가 달라졌는지 확인합니다.</p></div></li>
          <li data-vte-reveal><span aria-hidden="true">02</span><div><h3>치료 횟수와 간격을 살핍니다</h3><p>계획한 간격이 유지됐는지, 치료가 길게 중단된 기간은 없었는지 함께 봅니다.</p></div></li>
          <li data-vte-reveal><span aria-hidden="true">03</span><div><h3>병의 활동성을 다시 확인합니다</h3><p>새 병변이 생기는 시기에는 색소회복과 함께 진행을 줄이는 치료가 필요한지 평가합니다.</p></div></li>
          <li data-vte-reveal><span aria-hidden="true">04</span><div><h3>부위별 목표와 병행 치료를 조율합니다</h3><p>손발처럼 반응이 더딘 부위는 활동성이 있다면 진행 억제를 함께 고려하고, 안정된 병변은 치료 반응과 현실적인 목표를 조율합니다.</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="vte-section vte-preparation bleed" data-vte-section="5">
    <div class="wrapper--content vte-container vte-pad vte-prep-grid">
      <div data-vte-reveal>
        <header>
          <p class="vte-kicker">힐하우스피부과 엑시머 클리닉</p>
          <h2 class="vte-title">치료 당일 준비사항</h2>
          <h3 class="vte-prep-subtitle">치료 당일 준비</h3>
          <div class="vte-body vte-prep-copy vt-left-copy">
            <p>광선치료는 자외선 파장의 빛을 이용하기 때문에, 빛이 피부에 잘 닿도록 준비하는 것이 중요합니다. 치료 부위의 자외선 차단제와 화장은 번거롭더라도 꼭 지우고 오시는 것이 좋습니다. 빛의 일부가 가려질 수 있습니다.</p>
            <p>아침에 치료를 받는다면, 바르는 약(연고)은 치료가 끝난 뒤에 바르는 편이 좋습니다. 연고로 피부가 번들거리면 빛이 일부 반사될 수 있습니다.</p>
            <p>치료 부위와 강도는 개인마다 다르므로, 피부 상태나 컨디션 변화가 있으면 진료 시 알려 주세요.</p>
          </div>
        </header>

      </div>
        <ol class="vte-accordion" data-vte-accordion>
          <li>
            <h3>
              <button
                type="button"
                id="vte-acc-trigger-1"
                data-vte-acc-trigger
                aria-expanded="true"
