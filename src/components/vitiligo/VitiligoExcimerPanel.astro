  /* 원장 지시 2026-08-07 §6-3 — 위 요소(통계 블록)로부터 30 아래 */
  .vte-stat-note {
    margin: 30px 0 0;
    color: rgb(255 255 255 / 0.8);
    font-size: 13px;
    line-height: 20px;
  }

  /* §7 아래 흰 여백 제거(원장 지시 2026-08-07 §7) — 셸(VitiligoShell)이 서브 패널 공통으로
     주는 하단 여백 pb-16 md:pb-24 를 이 패널에서만 상쇄한다. 이 페이지는 배경이 있는
     칼럼 밴드가 문서를 마무리하므로 그 아래 흰 띠가 남으면 안 된다(about 패널이 셸에서
     같은 이유로 이 여백 클래스를 아예 받지 않는 것과 같은 규약). 셸은 나머지 서브 6개가
     함께 쓰는 파일이라 건드리지 않는다. */
  .vte {
    margin-bottom: -64px;
  }
  @media (min-width: 768px) {
    .vte {
      margin-bottom: -96px;
    }
  }

  .vte-reveal-ready [data-vte-reveal] {
    opacity: 0;
    transform: translateY(28px);
    /* 스크롤 등장(reveal)의 정본은 --editorial-reveal-duration(700ms)이다 — 종전 760ms 는
       근거 없는 60ms 차이였다(원장 지시 2026-09-04 「값 일관성」). 스태거 --vte-delay 와
       거리 28px 은 이 패널의 구성 값이라 그대로 둔다. */
    transition:
      opacity var(--editorial-reveal-duration) var(--ease-editorial),
      transform var(--editorial-reveal-duration) var(--ease-editorial);
    transition-delay: var(--vte-delay, 0ms);
  }
  .vte-reveal-ready [data-vte-reveal].is-visible {
    opacity: 1;
    transform: none;
  }
  /* §1 히어로만 등장 연출을 불투명도로 제한한다 — transform 이 걸려 있는 동안에는
     background-attachment: fixed 가 그 요소 기준으로 되돌아가(고정이 풀린다), 전환이
     끝나는 순간 배경이 한 번 튄다. 올라오는 모션 대신 페이드만 남긴다. */
  .vte-reveal-ready .vte-hero[data-vte-reveal] {
    transform: none;
  }

  @media (min-width: 768px) and (max-width: 1463px) {
    .vte-step-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(24px, 4vw, 58px);
    }
    .vte-step-arrow {
      top: clamp(112px, 13.5vw, 168px);
      right: clamp(-41px, -3.25vw, -24px);
    }
  }

  @media (max-width: 1023px) {
    .vte-intro-head,
    .vte-duration-head,
    .vte-prep-grid,
    .vte-team-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .vte-intro-copy {
      padding-top: 0;
    }
    .vte-step-grid {
      gap: 24px;
    }
    .vte-step-arrow {
      right: -24px;
    }
    .vte-notice {
      width: 100%;
    }
    .vte-ba-grid {
      grid-template-columns: 1fr;
    }
    .vte-prep-placeholder {
      max-height: 560px;
