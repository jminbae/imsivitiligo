  .vte-acc-plus {
    position: relative;
    width: 24px;
    height: 24px;
    color: var(--vte-brand);
  }
  .vte-acc-plus::before,
  .vte-acc-plus::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1.5px;
    background: currentColor;
    content: '';
    transform: translate(-50%, -50%);
    transition: transform 350ms var(--ease-editorial);
  }
  .vte-acc-plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
