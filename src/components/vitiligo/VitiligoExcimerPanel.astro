      margin-inline: auto;
    }
  }

  @media (max-width: 767px) {
    /* ── 백반증 공통 규격(원장 확정 2026-08-07) — 값은 전부 토큰(src/styles/vitiligo.css)에서.
       부제 18/24 · 제목 28/40 · 내용 16/26 · 섹션 상하 90 · 내용↔이미지 40 · 박스 radius 16.
       ⚠️ 여기에 숫자를 다시 적지 말 것 — 백반증 전 페이지가 이 한 곳에서 값을 받는다.
       ⚠️ PC(위 기본 블록)는 이번 지시 범위 밖이라 현행값 그대로 남겨 뒀다. 이 패널의 PC 값
          (부제 14/20 · 제목 36/54 · 내용 16/28)은 토큰 PC 기본값(20/28 · 40/60 · 18/32)과
          다르다 — 그 차이는 의도된 **예외**이므로 토큰 쪽을 바꾸지 말 것. ── */
    .vte-pad {
      padding-block: var(--vt-section-pad, 90px);
    }
    .vte-kicker {
      /* 부제 ↔ 제목 16 (종전 10px) */
      margin-bottom: var(--vt-gap-kicker-title, 16px);
      font-size: var(--vt-kicker-size, 18px);
      line-height: var(--vt-kicker-leading, 24px);
    }
    .vte-title,
    .vte-title--large {
      font-size: var(--vt-title-size, 28px);
      line-height: var(--vt-title-leading, 40px);
    }
    .vte-body {
      font-size: var(--vt-body-size, 16px);
      line-height: var(--vt-body-leading, 26px);
    }
    .vte-hero {
      aspect-ratio: 350 / 150;
      margin-top: var(--vt-gap-body-media, 40px);
      border-radius: var(--vt-radius, 16px);
    }
    /* 제목 ↔ 내용 — §2 헤더는 가운데 정렬이라 20 (좌측 정렬 30 과 다른 값이다) */
    .vte-centered .vte-lead {
      margin-top: var(--vt-gap-title-body-center, 20px);
    }
    /* 제목 ↔ 내용 — §1 인트로는 좌측 정렬이라 30. ≤1023 에서 1열로 접히며 컬럼 gap 이
       그대로 제목↔내용 간격이 된다(종전 48px). 같은 1023 규칙을 공유하는
       .vte-duration-head/.vte-prep-grid/.vte-team-grid 는 '제목↔내용'이 아니라 손대지 않는다. */
    .vte-intro-head {
      gap: var(--vt-gap-title-body, 30px);
    }
    .vte-lead br,
    .vte-nbuvb br {
      display: none;
    }
    .vte-step-grid {
      grid-template-columns: 1fr;
      gap: 64px;
      margin-top: 48px;
    }
    .vte-step-grid li {
      width: 100%;
    }
    .vte-step-arrow {
      top: auto;
      right: 50%;
      bottom: -44px;
      transform: rotate(270deg);
      translate: 50% 0;
    }
    .vte-nbuvb {
      margin-top: 24px;
    }
    .vte-nbuvb h3 {
      font-size: 21px;
      line-height: 28px;
    }
    .vte-nbuvb p {
      font-size: var(--vt-body-size, 16px);
      line-height: var(--vt-body-leading, 26px);
    }
    /* 모바일은 호버가 없다 — 종전 그대로 가로 스냅 스크롤 + 탭 확장(ExpandCardRow 모바일 모드).
       치수만 PC 확정 비율(264:360)에 맞춰 220×300 으로 맞추고, 확장 폭은 ExpandCardRow 의
       --expand-w(min(320px, 86vw)) 와 같은 값을 쓴다(220 × 380/264 ≈ 317 ≒ 320) */
    .vte-device-row {
      --vte-card-w: 220px;
      --vte-card-h: 300px;
      --vte-card-open-w: min(320px, 86vw);
      margin-inline: 0;
    }
    .vte-device-row :global(.ecr-row.ecr-fill) {
      gap: 14px;
      min-height: 400px;
      /* 좌우 여백은 '확장 카드를 화면 가운데 세울 수 있는 최소치'까지 벌린다.
         이 행은 scroll-snap-align:center + 탭 시 중앙 스크롤인데, 여백이 그보다 좁으면
         첫/끝 카드는 콘텐츠가 거기서 끝나 버려 물리적으로 가운데에 못 온다(스크롤이 잘린다).
         종전 20px 고정에서는 그 오차가 화면이 넓을수록 커졌다 — 실측 375px 에서 7.5px,
         430px 에서 35px. max() 라 좁은 화면에서는 종전 디자인값 20px 그대로다.
         (같은 이유로 §5 얼굴 백반증 행도 padding-inline 을 예약해 두었다 — 같은 어법) */
      padding: 0 max(20px, calc((100vw - var(--vte-card-open-w)) / 2)) 8px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      /* 가로 스크롤 리스트의 대전제 — 넘치는 행을 center 로 정렬하면 앞선 칸이 스크롤
         원점 왼쪽(음수 offset)으로 밀려 도달 불가가 된다(위 PC 블록 게이트 주석 참조).
         ExpandCardRow 모바일 기본값과 같은 값이지만, 이 파일의 다른 규칙이 특이도로
         이기는 구조라 여기서 명시해 둔다. */
      justify-content: flex-start;
    }
    .vte-device-row :global(.ecr-row.ecr-fill .ecr-cell) {
      flex: 0 0 var(--vte-card-w);
      scroll-snap-align: center;
    }
    /* 탭 확장 — 위 접힘 규칙이 ExpandCardRow 의 모바일 is-active 보다 특이도가 높아
       여기서 같은 계열로 한 번 더 선언해야 확장이 산다(폭 값은 동일) */
    .vte-device-row :global(.ecr-row.ecr-fill .ecr-cell.is-active) {
      flex: 0 0 var(--vte-card-open-w);
    }
    .vte-device-row :global(.ecr-row .ecr-card),
    .vte-device-row :global(.ecr-row.ecr-fill .ecr-card) {
      height: auto;
      min-height: var(--vte-card-h);
    }
    .vte-device-row :global(.ecr-cell.is-active .ecr-text) {
      min-height: 330px;
    }
    .vte-device-row :global(.ecr-text) {
      padding: 18px;
      --e-ti-size: 19px;
      --e-ti-lh: 24px;
      --e-body-size: 14px;
      --e-body-lh: 22px;
    }
    .vte-duration-head {
      gap: 40px;
    }
    .vte-duration-copy {
      margin-top: 24px;
    }
    .vte-notice {
      min-height: 0;
      padding: 24px;
    }
    .vte-notice h3 {
      font-size: 20px;
      line-height: 28px;
    }
    .vte-notice p {
      font-size: var(--vt-body-size, 16px);
      line-height: var(--vt-body-leading, 26px);
    }
    .vte-ba-grid {
      margin-top: 40px;
    }
    .vte-ba-set {
      aspect-ratio: 350 / 122;
      border-radius: 10px;
    }
    .vte-ba-arrow {
      width: 34px;
      height: 34px;
    }
    .vte-prep-subtitle {
      margin-top: 32px;
      font-size: 21px;
    }
    .vte-accordion {
      margin-top: 32px;
    }
    .vte-accordion button {
      grid-template-columns: 38px minmax(0, 1fr) 24px;
      min-height: 64px;
      padding-right: 18px;
      font-size: 16px;
      line-height: 24px;
    }
    .vte-acc-num {
      width: 38px;
      height: 38px;
    }
    .vte-prep-placeholder {
      aspect-ratio: 350 / 280;
    }
    .vte-team h2 {
      font-size: var(--vt-title-size, 28px);
      line-height: var(--vt-title-leading, 40px);
    }
    .vte-team header p {
      margin-top: 24px;
      font-size: var(--vt-body-size, 16px);
      line-height: var(--vt-body-leading, 26px);
    }
    .vte-stats {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .vte-stat {
      min-height: 142px;
    }
    .vte-stat dt {
      min-height: auto;
      font-size: 17px;
      line-height: 27px;
    }
    .vte-stat dd {
      margin-top: 16px;
    }
    .vte-stat dd > [aria-hidden='true'] {
      font-size: 52px;
      line-height: 62px;
    }
