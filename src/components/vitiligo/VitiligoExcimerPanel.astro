    gap: 20px;
    align-items: end;
  }
  .vte-duration-copy {
    display: flex;
    flex-direction: column;
    margin-top: 30px;
  }
  .vte-notice {
    width: min(690px, 100%);
    min-height: 164px;
    padding: 30px;
    border-radius: 16px;
    /* 원장 지시 2026-08-07 §4 — #6899C0 투명도 10% */
    background: rgb(104 153 192 / 0.1);
    backdrop-filter: blur(10px);
  }
  .vte-notice-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .vte-notice-title img {
    width: 28px;
    height: 28px;
  }
  .vte-notice h3 {
    margin: 0;
    color: #66727C;
    font-size: 24px;
    font-weight: 600;
    line-height: 28px;
  }
  .vte-notice p {
    margin: 18px 0 0;
    color: var(--vte-ink);
    font-size: 16px;
    line-height: 28px;
    word-break: keep-all;
  }
  .vte-ba-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 690px));
    gap: 20px;
    margin-top: 60px;
  }
  .vte-ba-set {
    aspect-ratio: 690 / 240;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border-radius: 16px;
  }
  .vte-ba-pair {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
  }
  .vte-ba-image {
    width: 50%;
    height: 100%;
    object-fit: cover;
  }
  .vte-ba-arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
  }

  .vte-prep-grid {
    display: grid;
    grid-template-columns: minmax(0, 690px) minmax(0, 690px);
    gap: 20px;
    align-items: center;
  }
  .vte-prep-subtitle {
    margin: 40px 0 0;
    color: var(--vte-ink);
    font-size: 24px;
    font-weight: 600;
    line-height: 28px;
  }
  .vte-prep-copy {
    margin-top: 18px;
  }
  .vte-prep-copy p {
    margin: 0;
  }
  .vte-prep-copy p + p {
    margin-top: 10px;
  }
  /* 원장 지시 2026-08-07 §5 — 사진 가로 630. 시안(260806-백반증_엑시머클리닉.png) 실측상
     오른쪽 끝이 컨테이너 우변에 맞춰져 있어 열 안에서 우측 정렬한다(690 열 − 630 = 60 좌측 여백) */
  .vte-prep-placeholder {
    aspect-ratio: 690 / 610;
    width: min(630px, 100%);
    margin-left: auto;
    background: #E2E2E2;
  }
  .vte-accordion {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  .vte-accordion li {
    overflow: hidden;
    border-radius: 36px;
    background: #FFFFFF;
    box-shadow: 0 6px 21.5px rgb(157 173 185 / 0.25);
  }
  .vte-accordion h3 {
    margin: 0;
  }
  .vte-accordion button {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 24px;
    gap: 16px;
    align-items: center;
    width: 100%;
    min-height: 72px;
    padding: 0 24px 0 15px;
    color: var(--vte-ink);
    font-size: 18px;
    font-weight: 600;
    line-height: 28px;
    text-align: left;
  }
  .vte-acc-num {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
