<script>
  import { initAdaptiveRail } from './about/adaptiveRail';

  const causeRail = document.querySelector<HTMLElement>('#vta-causes-rail');
  if (causeRail) initAdaptiveRail(causeRail, 'causes');
  import { syncDisclosureState } from './about/disclosureState.mjs';
  import { initEditorialReveal } from '../../lib/editorialReveal.mjs';

  // ── §4 카드 탭 토글 스크립트는 공용 VtaTypeCardsSection(2026-07-31 추출)이 보유 —
  // 문서당 1회 삽입 + [data-vta-picker] querySelectorAll 바인딩이라 여기 중복 두면
  // 이중 토글(클릭 무효)이 된다. 이 파일에는 두지 말 것.

  // §1 사진 — 자동 순환 없이 사용자가 선택한 사진만 강조한다.
  {
    const strip = document.querySelector<HTMLElement>('[data-vta-photo-strip]');
    if (strip) {
      const photos = Array.from(strip.querySelectorAll<HTMLButtonElement>('[data-vta-photo]'));
      const activate = (next: number) => {
        photos.forEach((photo, index) => {
          const active = index === next;
          photo.classList.toggle('is-active', active);
          photo.setAttribute('aria-pressed', String(active));
        });
      };
      photos.forEach((photo, index) => {
        photo.addEventListener('focus', () => activate(index));
        photo.addEventListener('click', () => activate(index));
      });
    }
  }

  // 섹션별 fade-up — 지점 상세와 같은 공통 정본을 사용한다.
  {
    const root = document.querySelector<HTMLElement>('[data-vta-about-root]');
    if (root) {
      const cleanupReveal = initEditorialReveal({ root, targets: '.vta-reveal' });
      document.addEventListener('astro:before-swap', cleanupReveal, { once: true });
    }
  }

  // ── §7 진단 배타 아코디언(원장 지시 2026-08-01 "닫혀 있고, 클릭하면 열리고, 다른 거
  // 클릭하면 나머진 닫히고") — 공용 FaqAccordion 스크립트 문법 이식(한 번에 하나·재클릭
  // 닫힘·키보드는 네이티브 button 이 처리). no-JS 는 전부 펼침 렌더이므로 여기서 전부
  // 닫고 시작 — 초기 접힘이 애니메이션으로 보이지 않게 리플로 확정 후 vta-diag-ready 로
  // 전환을 활성화한다.
  {
    const root = document.querySelector<HTMLElement>('[data-vta-diag]');
    if (root) {
      const lis = Array.from(root.querySelectorAll<HTMLLIElement>('li'));
      const setOpen = (li: HTMLLIElement, open: boolean) => {
        li.classList.toggle('is-open', open);
        const trigger = li.querySelector<HTMLButtonElement>('[data-vta-diag-t]');
        const panel = li.querySelector<HTMLElement>('[data-vta-diag-panel]');
        if (trigger && panel) syncDisclosureState(trigger, panel, open);
      };
      lis.forEach((li) => setOpen(li, false));
      void root.offsetHeight; // 접힘 상태를 페인트 전에 확정(로드 플래시 방지)
      root.classList.add('vta-diag-ready');
      lis.forEach((li) => {
        li.querySelector<HTMLButtonElement>('[data-vta-diag-t]')?.addEventListener('click', () => {
          const willOpen = !li.classList.contains('is-open');
          lis.forEach((o) => setOpen(o, o === li && willOpen));
        });
      });
    }
  }

  // ── §6 FAQ — 클릭 확장(한 번에 하나)·× 닫기 + PC 마우스 패럴럭스(±10px, rAF·lerp).
  // reduced-motion·터치 기기는 패럴럭스 없음(둥실은 CSS가 자체 정지).
  {
    const field = document.querySelector<HTMLElement>('[data-vta-faq-field]');
    if (field) {
      const boxes = Array.from(field.querySelectorAll<HTMLElement>('[data-vta-faq]'));
      const setOpen = (box: HTMLElement, open: boolean) => {
        box.classList.toggle('is-open', open);
        const trigger = box.querySelector<HTMLButtonElement>('.vta-faq-toggle');
        const panel = box.querySelector<HTMLElement>('[data-vta-faq-panel]');
        if (trigger && panel) syncDisclosureState(trigger, panel, open);
      };
      boxes.forEach((box) => {
        const btn = box.querySelector<HTMLButtonElement>('.vta-faq-toggle');
        btn?.addEventListener('click', () => {
          const wasOpen = box.classList.contains('is-open');
          boxes.forEach((other) => setOpen(other, false));
          if (!wasOpen) setOpen(box, true);
        });

        /* 칸 전체 클릭으로 열기(원장 지시 2026-08-01 "글씨 클릭뿐 아니라 그 칸 클릭해도 열리게").
           종전에는 질문 텍스트를 감싼 button 만 클릭 대상이라 박스 여백을 누르면 반응이 없었다.
           박스 아무 곳이나 눌러도 버튼 클릭으로 위임한다.
           설계 판단:
           · 이미 열린 박스에서는 위임하지 않는다 — 본문을 읽거나 드래그 선택하려고 누른 것을
             '닫기'로 오해하면 안 된다. 닫기는 × 버튼(=button)이 담당한다.
           · button 안쪽 클릭은 위임하지 않는다(중복 발화 방지 — 위 핸들러가 이미 처리).
           · 마크업·접근성은 불변: button 이 계속 유일한 포커스 대상이라 키보드 순서·낭독이
             그대로다. 박스를 button 으로 바꾸면 본문 안의 요소까지 버튼 안에 들어가 어색해진다. */
        box.addEventListener('click', (e) => {
          if (!btn || box.classList.contains('is-open')) return;
          if ((e.target as HTMLElement)?.closest('button')) return;
          btn.click();
        });
      });

      // HTML/CSS 기본값은 답변 전체 노출이다. 리스너가 모두 준비된 뒤에만 접힘 모드로 전환한다.
      boxes.forEach((box) => setOpen(box, false));
      field.classList.add('vta-faq-ready');
      void field.offsetHeight;
      requestAnimationFrame(() => field.classList.add('vta-faq-animate'));

      const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      // ── §6 자유 부유(원장 지시 2026-08-01 "위치를 그때그때 랜덤하게, 천천히 계속 이동,
      //    좀 자유롭게 위치 바뀌게 서서히") — 정적 행 배치를 자유 필드로 전환:
      //    1) 방문마다 랜덤 산포 — 균일 랜덤 다트 던지기(최소 여백 28px 조건) + 잔여 완화
      //    2) 부유 — 박스별 속도 3.5~7px/s(사이트 마퀴들보다 느긋), 진행각 = 기준각(초저속
      //       회전) + 사인 2결합(주기 35~160s) → 완만히 휘는 곡선, 직선 왕복 티 없음
      //    3) 경계 — 안쪽 40px부터 깊이 비례 스프링으로 완만히 되돌림 + 하드 클램프
      //    4) 확장 박스 — 부유 지속(원장 정정 2026-08-01) + is-top 최상위, 경계·반발은
      //       확장 실측 크기(ew/eh) 기준
      //    5) 지속 쌍별 반발(원장 제보·후속 2026-08-01, 강화 2026-08-07 "너무 겹쳐서
      //       다닐 때가 있다") — 닫힘끼리는 26px 근접 회피 밴드(깊이 제곱 램프, 맞닿는
      //       지점 34px/s)로 글자가 가리기 전에 서로 비켜난다. 열린 박스는 배타 구역
      //       (확장 rect + 8px 에서 닫힌 이웃이 완전히 비켜날 때까지 강한 반발·easeOut,
      //       공간 없으면 부분 겹침만 허용)
      //    6) 호버(PC 파인 포인터) — 해당 박스만 ×0.15 감속(lerp 로 서서히 전환)
      //    rAF 1루프가 전 박스 처리, IntersectionObserver 로 화면 밖에서는 루프 정지.
      //    필드 높이 = 정적 배치 실측값 인라인 고정 → 주변 레이아웃 시프트 없음. ──
      {
        const items = Array.from(field.querySelectorAll<HTMLElement>('.vta-faq-item'));
        interface FloatState {
          el: HTMLElement;
          box: HTMLElement;
          x: number;
          y: number;
          w: number;
          h: number;
          th: number; // 기준 진행각(rad)
          rot: number; // 기준각 초저속 회전(rad/s)
          a1: number; // 사인 결합 진폭·각속도·위상 2벌
          o1: number;
          p1: number;
          a2: number;
          o2: number;
          p2: number;
          spd: number; // 기본 속도(px/s)
          mul: number; // 현재 속도 배율(호버·확장 lerp)
          hov: boolean;
          open: boolean;
          ew: number; // 확장 실측 크기(열림 중 경계·반발 계산용)
          eh: number;
          bw: number; // 이번 프레임 유효 크기(열림 = ew/eh, 닫힘 = w/h)
          bh: number;
          vx: number; // 이번 프레임 합성 속도(부유 + 경계 + 반발)
          vy: number;
          exAx: '' | 'x' | 'y'; // 배타 구역 탈출 방향 히스테리시스(닫힌 박스용)
          exDir: number;
        }
        let states: FloatState[] = [];
        let W = 0;
        let H = 0;
        let raf = 0;
        let lastT = 0;
        let visible = false;
        let ready = false;
        let observing = false;
        const rand = (a: number, b: number) => a + Math.random() * (b - a);
        const apply = (s: FloatState) => {
          s.el.style.transform = `translate3d(${s.x.toFixed(2)}px, ${s.y.toFixed(2)}px, 0)`;
        };
        const clampAll = () => {
          states.forEach((s) => {
            s.x = Math.min(Math.max(s.x, 0), Math.max(W - s.w, 0));
            s.y = Math.min(Math.max(s.y, 0), Math.max(H - s.h, 0));
          });
        };
        const SEP_GAP = 28; // 초기 배치 목표 여백(px)
        const SEP_BAND = 26; // 닫힘·닫힘 근접 회피 밴드 — 이 여유 안으로 들면 밀어내기 시작
        const SEP_MAX = 34; // 맞닿는 순간의 분리 속도(px/s, 두 박스 합계)
        const SEP_HARD = 64; // 이미 깊게 겹친 상태(열림 확장 등)의 해소 속도 상한
        /* 초기 산포 — 최선후보 다트 던지기(포아송 디스크 샘플링류).
           박스마다 필드 전역에 균일 랜덤 후보를 던져, 이미 놓인 박스와의 최소 AABB 여백이
           SEP_GAP 이상인 첫 후보를 채택한다(끝내 못 채우면 그중 여백이 가장 큰 자리).
           큰 박스부터 놓아야 남은 자리에 작은 박스가 들어갈 확률이 높다. 좁은 필드(모바일)
           에서 조건을 못 채운 잔여분만 AABB 완화로 정리한다.
           ⚠️ 종전 방식(셔플 3×2 그리드 셀 + ±25% 지터 + 12px 완화 24회)은 셀 폭(≈445px)이
           가장 넓은 박스 폭(≈366px)과 비슷해 지터가 셀 경계를 넘겼다 — PC 방문의 31%가
           26px 미만 간격으로, 모바일 방문의 17%는 아예 겹친 채로 시작했다(1000회 시뮬레이션).
           무작위 시작(원장 지시 2026-08-01)은 그대로다 — 격자에 스냅하지 않고 균일 랜덤에
           최소 간격 조건만 얹었다. */
        const scatter = () => {
          const placed: FloatState[] = [];
          [...states]
            .sort((a, b) => b.w * b.h - a.w * a.h)
            .forEach((s) => {
              const maxX = Math.max(W - s.w, 0);
              const maxY = Math.max(H - s.h, 0);
              let bestX = 0;
              let bestY = 0;
              let bestGap = -Infinity;
              for (let k = 0; k < 160; k++) {
                const x = Math.random() * maxX;
                const y = Math.random() * maxY;
                let gap = Infinity;
                for (const p of placed) {
                  const gx = Math.max(p.x - (x + s.w), x - (p.x + p.w));
                  const gy = Math.max(p.y - (y + s.h), y - (p.y + p.h));
                  gap = Math.min(gap, Math.max(gx, gy));
                }
                if (gap > bestGap) {
                  bestGap = gap;
                  bestX = x;
                  bestY = y;
                }
                if (gap >= SEP_GAP) break;
              }
              s.x = bestX;
              s.y = bestY;
              placed.push(s);
            });
          for (let k = 0; k < 40; k++) {
            for (let i = 0; i < states.length; i++)
              for (let j = i + 1; j < states.length; j++) {
                const a = states[i]!;
                const b = states[j]!;
                const ox = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x) + SEP_GAP;
                const oy = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y) + SEP_GAP;
                if (ox > 0 && oy > 0) {
                  if (ox < oy) {
                    const d = (ox / 2) * Math.sign(a.x + a.w / 2 - (b.x + b.w / 2) || 1);
                    a.x += d;
                    b.x -= d;
                  } else {
                    const d = (oy / 2) * Math.sign(a.y + a.h / 2 - (b.y + b.h / 2) || 1);
                    a.y += d;
                    b.y -= d;
                  }
                }
              }
            clampAll();
          }
          states.forEach(apply);
        };
        const syncOpen = () => {
          states.forEach((s) => {
            const open = s.box.classList.contains('is-open');
            if (open && !s.open) {
              // 확장 예상 크기 — 답변 p 는 접힘 중에도 고정 폭으로 레이아웃되어 실측 가능.
              // 열려 있는 동안에도 부유는 계속(원장 정정 2026-08-01 "멈추지 마, 계속 움직여야
              // 자연스럽다") — 정지·수납 목표 대신 확장 실측 크기를 경계 계산에 쓰는 것으로
              // 넘침만 방지한다(경계 스프링이 확장 크기 기준으로 완만히 안쪽 유지).
              const p = s.box.querySelector<HTMLElement>('.vta-faq-a-in p');
              const cs = getComputedStyle(s.box);
              const padX = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
              s.ew = Math.max(s.w, (p?.offsetWidth ?? 0) + padX);
              s.eh = s.h + (p?.offsetHeight ?? 0) + 15;
            }
            s.open = open;
            s.el.classList.toggle('is-top', open);
          });
        };
        const tick = (t: number) => {
          raf = 0;
          const dt = Math.min(Math.max((t - lastT) / 1000, 0), 0.05);
          lastT = t;
          const ts = t / 1000;
          const M = 40; // 경계 스프링 시작 여유(px)
          // 1패스 — 박스별 자체 속도(부유 + 경계 스프링). 위치는 아직 쓰지 않는다
          states.forEach((s) => {
            // 열려 있어도 부유 지속(원장 정정 2026-08-01) — 호버 감속만 유지
            const goal = s.hov ? 0.15 : 1;
            s.mul += (goal - s.mul) * Math.min(1, dt * 2.5);
            // 경계·반발은 열림 상태의 실측 확장 크기 기준 — 열린 박스가 잘리거나 가리지 않게
            s.bw = s.open ? s.ew : s.w;
            s.bh = s.open ? s.eh : s.h;
            s.th += s.rot * dt;
            const ang =
              s.th + s.a1 * Math.sin(s.o1 * ts + s.p1) + s.a2 * Math.sin(s.o2 * ts + s.p2);
            const v = s.spd * s.mul;
            s.vx = Math.cos(ang) * v;
            s.vy = Math.sin(ang) * v;
            if (s.x < M) s.vx += (M - s.x) * 0.25;
            if (s.x > W - s.bw - M) s.vx -= (s.x - (W - s.bw - M)) * 0.25;
            if (s.y < M) s.vy += (M - s.y) * 0.25;
            if (s.y > H - s.bh - M) s.vy -= (s.y - (H - s.bh - M)) * 0.25;
          });
          // 2패스 — 쌍별 반발. 두 층위(원장 후속 2026-08-01 "서로 배타적으로 밀려나게"):
          //  · 닫힘·닫힘 — 근접 회피 밴드(SEP_BAND). 여유가 밴드 안으로 들어오는 순간부터
          //    침투 깊이의 제곱에 비례해 밀어내고, 맞닿는 지점(pen = SEP_BAND)에서 SEP_MAX
          //    에 도달한다. 부유 최고속(7px/s)의 합류 속도 14px/s 를 SEP_MAX 34px/s 가
          //    확실히 이기므로 정면으로 다가와도 글자를 가리기 전에 비켜난다.
          //    제곱 램프라 밴드 바깥 가장자리에서는 힘이 0 에 수렴 — 툭 튕기는 느낌 없이
          //    서로 피해 가는 몸짓으로 읽힌다(1000회 시뮬레이션에서 박스가 자체 부유속도의
          //    1.6배를 넘는 시간은 PC 0.2%·모바일 0.6%로, 종전과 같은 '천천히' 질감 유지).
          //    ⚠️ 종전 값(여유 6px·게인 0.3/s·캡 12px/s·절반씩)은 절반씩 나누면 박스당
          //    6px/s 라 부유속도보다 느렸다 — 정면으로 만나면 이길 수 없어 서로 통과했고,
          //    그 결과 PC 는 체류 시간의 71.7%, 모바일은 99.0%가 겹친 상태였다.
          //  · 열림·닫힘 — 배타 구역: 닫힌 쪽이 확장 rect(ew/eh) + 여유 8px 와의 겹침이
          //    완전히 해소될 때까지 게인 1.5/s·캡 70px/s 로 밀려남(질량 0.06:0.94 — 읽는
          //    박스는 거의 정지). 깊이 비례 속도라 처음엔 캡 속도로 빠르게 빠져나오고
          //    얕아질수록 지수 감속(easeOut) — 실겹침 해소까지 대략 1~2s.
          //    탈출 방향은 최소 깊이축 고정이 아니라 '필드 안에서 완전 탈출 가능한 4방향 중
          //    최단'을 고른다 — 공간이 전부 부족하면(좁은 모바일) 잔여 겹침이 가장 작은
          //    방향으로만 밀고 부분 겹침 허용(열린 박스가 is-top 이라 읽기는 유지, 클램프에
          //    눌린 채 속도 합산·클램프 1회 구조라 경계와 싸우는 진동 없음). 직전 프레임
          //    방향에 0.7 히스테리시스 — 깊이 교차 순간의 방향 덜컥임 방지
          for (let i = 0; i < states.length; i++)
            for (let j = i + 1; j < states.length; j++) {
              const a = states[i]!;
              const b = states[j]!;
              const openPair = a.open || b.open; // 아코디언이라 열림은 한 번에 하나
              const m = openPair ? 8 : SEP_BAND;
              const ox = Math.min(a.x + a.bw, b.x + b.bw) - Math.max(a.x, b.x) + m;
              const oy = Math.min(a.y + a.bh, b.y + b.bh) - Math.max(a.y, b.y) + m;
              if (ox <= 0 || oy <= 0) {
                if (openPair) (a.open ? b : a).exAx = '';
                continue;
              }
              if (!openPair) {
                const u = Math.min(ox, oy) / SEP_BAND;
                const v = Math.min(SEP_MAX * u * u, SEP_HARD);
                if (ox < oy) {
                  const sg = Math.sign(a.x + a.bw / 2 - (b.x + b.bw / 2) || 1);
                  a.vx += v * 0.5 * sg;
                  b.vx -= v * 0.5 * sg;
                } else {
                  const sg = Math.sign(a.y + a.bh / 2 - (b.y + b.bh / 2) || 1);
                  a.vy += v * 0.5 * sg;
                  b.vy -= v * 0.5 * sg;
                }
                continue;
              }
              const o = a.open ? a : b;
              const c = a.open ? b : a;
              // 4방향 후보 — need = 탈출에 필요한 이동량, room = 그 방향의 필드 여유
              const cands: { ax: 'x' | 'y'; dir: number; need: number; room: number }[] = [
                { ax: 'x', dir: -1, need: ox, room: c.x },
                { ax: 'x', dir: 1, need: ox, room: W - c.bw - c.x },
                { ax: 'y', dir: -1, need: oy, room: c.y },
                { ax: 'y', dir: 1, need: oy, room: H - c.bh - c.y },
              ];
              let best = cands[0]!;
              let bestScore = Infinity;
              cands.forEach((cd) => {
                // 완전 탈출 가능하면 need 최단 우선, 전부 불가면 잔여 겹침 최소 방향
                let score = cd.room >= cd.need ? cd.need : 1e6 + (cd.need - cd.room);
                if (cd.ax === c.exAx && cd.dir === c.exDir) score *= 0.7;
                if (score < bestScore) {
                  bestScore = score;
                  best = cd;
                }
              });
              c.exAx = best.ax;
              c.exDir = best.dir;
              const v = Math.min(best.need * 1.5, 70);
              if (best.ax === 'x') {
                c.vx += best.dir * v * 0.94;
                o.vx -= best.dir * v * 0.06;
              } else {
                c.vy += best.dir * v * 0.94;
                o.vy -= best.dir * v * 0.06;
              }
            }
          // 3패스 — 적분 + 하드 클램프 + 적용
          states.forEach((s) => {
            s.x += s.vx * dt;
            s.y += s.vy * dt;
            s.x = Math.min(Math.max(s.x, 0), Math.max(W - s.bw, 0));
            s.y = Math.min(Math.max(s.y, 0), Math.max(H - s.bh, 0));
            apply(s);
          });
          if (visible && !reduced.matches && !document.hidden)
            raf = requestAnimationFrame(tick);
        };
        const start = () => {
          if (!raf && ready && visible && !reduced.matches && !document.hidden) {
            lastT = performance.now();
            raf = requestAnimationFrame(tick);
          }
        };
        const stopFloating = () => {
          if (raf) cancelAnimationFrame(raf);
          raf = 0;
        };
        const resetFloating = () => {
          stopFloating();
          items.forEach((el) => {
            el.style.transform = '';
            el.classList.remove('is-top');
          });
          field.classList.remove('vta-free');
          field.style.height = '';
          states = [];
          ready = false;
        };
        const init = () => {
          if (ready || reduced.matches) return;
          const rect = field.getBoundingClientRect();
          if (rect.width < 10 || rect.height < 10) return; // 숨김 상태 — 표시 후 IO 에서 재시도
          field.style.height = `${Math.round(rect.height)}px`;
          field.classList.add('vta-free');
          states = items.map((el) => ({
            el,
            box: el.querySelector<HTMLElement>('[data-vta-faq]')!,
            x: 0,
            y: 0,
            w: el.offsetWidth,
            h: el.offsetHeight,
            th: rand(0, Math.PI * 2),
            rot: rand(-0.04, 0.04),
            a1: rand(0.5, 0.9),
            o1: rand(0.04, 0.09),
            p1: rand(0, Math.PI * 2),
            a2: rand(0.7, 1.2),
            o2: rand(0.1, 0.18),
            p2: rand(0, Math.PI * 2),
            spd: rand(3.5, 7),
            mul: 1,
            hov: false,
            open: false,
            ew: 0,
            eh: 0,
            bw: 0,
            bh: 0,
            vx: 0,
            vy: 0,
            exAx: '' as const,
            exDir: 0,
          }));
          W = field.clientWidth;
          H = field.clientHeight;
          scatter();
          syncOpen();
          ready = true;
        };
        if (fine.matches) {
          items.forEach((el) => {
            el.addEventListener('mouseenter', () => {
              const s = states.find((v) => v.el === el);
              if (s) s.hov = true;
            });
            el.addEventListener('mouseleave', () => {
              const s = states.find((v) => v.el === el);
              if (s) s.hov = false;
            });
          });
        }
        // 확장 토글 동기화 — 버튼 자체 핸들러(위)가 타깃 단계에서 먼저 실행된 뒤
        // 버블 단계의 이 리스너가 is-open 결과를 상태에 반영한다
        field.addEventListener('click', () => {
          if (ready) syncOpen();
        });
        // 화면 밖 = 루프 정지(성능), 재진입 시 재개
        const io = new IntersectionObserver(
          (entries) => {
            visible = entries.some((e) => e.isIntersecting);
            if (visible && !reduced.matches) {
              init();
              start();
            } else stopFloating();
          },
          { rootMargin: '120px' }
        );
        const enableFloating = () => {
          if (reduced.matches) return;
          const rect = field.getBoundingClientRect();
          visible =
            !document.hidden && rect.bottom >= -120 && rect.top <= window.innerHeight + 120;
          init();
          if (!observing) {
            io.observe(field);
            observing = true;
          }
          start();
        };
        const handleFloatingMotionPreference = () => {
          if (reduced.matches) resetFloating();
          else enableFloating();
        };
        reduced.addEventListener('change', handleFloatingMotionPreference);
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stopFloating();
          else if (!reduced.matches) enableFloating();
        });
        handleFloatingMotionPreference();
        // 뷰포트 폭 급변(브레이크포인트 이동) — 정적 재실측 후 재산포
        let rw = window.innerWidth;
        let rt = 0;
        window.addEventListener('resize', () => {
          if (reduced.matches || Math.abs(window.innerWidth - rw) < 60) return;
          window.clearTimeout(rt);
          rt = window.setTimeout(() => {
            rw = window.innerWidth;
            resetFloating();
            enableFloating();
          }, 250);
        });
      }

      if (fine.matches) {
        const pars = Array.from(field.querySelectorAll<HTMLElement>('[data-vta-par]'));
        let tx = 0;
        let ty = 0;
        let cx = 0;
        let cy = 0;
        let raf = 0;
        let pointerInside = false;
        let pointerX = 0;
        let pointerY = 0;
        const clearParallax = () => {
          pars.forEach((p) => {
            p.style.transform = '';
          });
        };
        const stopParallax = () => {
          if (raf) cancelAnimationFrame(raf);
          raf = 0;
          tx = 0;
          ty = 0;
          cx = 0;
          cy = 0;
          clearParallax();
        };
        const updateParallaxTarget = () => {
          const r = field.getBoundingClientRect();
          if (!r.width || !r.height) return false;
          tx = ((pointerX - r.left) / r.width - 0.5) * 2 * 10;
          ty = ((pointerY - r.top) / r.height - 0.5) * 2 * 10;
          return r.bottom > 0 && r.top < window.innerHeight;
        };
        const tick = () => {
          raf = 0;
          if (reduced.matches) {
            stopParallax();
            return;
          }
          cx += (tx - cx) * 0.08;
          cy += (ty - cy) * 0.08;
          pars.forEach((p) => {
            const fx = parseFloat(p.dataset.fx || '0');
            const fy = parseFloat(p.dataset.fy || '0');
            p.style.transform = `translate(${(cx * fx).toFixed(2)}px, ${(cy * fy).toFixed(2)}px)`;
          });
          if (Math.abs(tx - cx) > 0.05 || Math.abs(ty - cy) > 0.05) raf = requestAnimationFrame(tick);
        };
        field.addEventListener('mousemove', (e) => {
          pointerInside = true;
          pointerX = e.clientX;
          pointerY = e.clientY;
          if (reduced.matches || !updateParallaxTarget()) return;
          if (!raf) raf = requestAnimationFrame(tick);
        });
        field.addEventListener('mouseleave', () => {
          pointerInside = false;
          if (reduced.matches) {
            stopParallax();
            return;
          }
          tx = 0;
          ty = 0;
          if (!raf) raf = requestAnimationFrame(tick);
        });
        const resumeParallax = () => {
          if (pointerInside && updateParallaxTarget() && !raf)
            raf = requestAnimationFrame(tick);
        };
        const handleParallaxMotionPreference = () => {
          if (reduced.matches) stopParallax();
          else resumeParallax();
        };
        reduced.addEventListener('change', handleParallaxMotionPreference);
        handleParallaxMotionPreference();
      }
    }
  }
</script>
