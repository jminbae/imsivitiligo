---
/**
 * VitiligoAboutPanel — /vitiligo/about/ (백반증이란?) DB 콘텐츠 기반 소개 섹션 + 공용 칼럼 섹션.
 * 참고 시안: 전달용/00 예시이미지/250804-백반증-백반증이란.png
 * §1~3·§6~7은 이 파일에 격리하고, §4·§5의 기존 카드 인터랙션만 공용 컴포넌트를 재사용한다.
 * 진단 6개·칼럼·의사 바이라인은 JSON/저장소 데이터를 그대로 사용한다.
 * 섹션 등장 모션은 기본 렌더가 보이는 progressive enhancement 방식이며 reduced-motion을 따른다.
 * ※ 연구 소개 섹션(구 §8)은 원장 지시 2026-08-07 로 이 페이지에서 삭제됐다.
 *   같은 내용은 /vitiligo/ 메인과 /vitiligo/research/ 가 계속 제공한다.
 */
import VtaTypeCardsSection from './VtaTypeCardsSection.astro';
import PagingIndicator from '../ui/PagingIndicator.astro';
import VitiligoRelatedColumns from './VitiligoRelatedColumns.astro';
import VitiligoFloatingField from './VitiligoFloatingField.astro';
import type { VitiligoSection, VitiligoBlock } from '../../lib/types';

interface Props {
  section: VitiligoSection;
  /** 진입 URL의 패널인지 — 진입 애니메이션은 첫 표시 패널에만 */
  initial: boolean;
}

const { section, initial } = Astro.props;

// about 콘텐츠는 저장소 어댑터가 빌드 시 검증한 DB 값만 렌더한다.
const content = section.aboutContent;
const aboutEyebrow = '힐하우스피부과 백반증이란?';
const aboutImages = '/images/vitiligo/about';
if (!content) throw new Error('Vitiligo about content is required');
const b = section.blocks;
const causes = b[2] as Extract<VitiligoBlock, { type: 'deflist' }>;
const koebner = b[3] as Extract<VitiligoBlock, { type: 'callout' }>;
const types = b[4] as Extract<VitiligoBlock, { type: 'type-picker' }>;
const faces = b[5] as Extract<VitiligoBlock, { type: 'face-picker' }>;
const myths = b[6] as Extract<VitiligoBlock, { type: 'faq' }>;
const diagTools = b[8] as Extract<VitiligoBlock, { type: 'faq' }>;
const diagNotes = b.slice(9) as Extract<VitiligoBlock, { type: 'callout' }>[];
const diagItems = [
  ...diagTools.items.map((it) => ({ term: it.q, desc: it.a })),
  ...diagNotes.map((c) => ({ term: c.label, desc: c.body_md })),
];
const faceItems = faces.items;

/* §6 FAQ 배치 — 이 행 구성·PC 오프셋(dy)·모바일 좌/우 오프셋(mo)은 no-JS·reduced-motion
   정적 폴백 전용. JS 가 살아 있으면 스크립트가 필드를 자유 부유 모드로 전환해 방문마다
   랜덤 산포한다(원장 지시 2026-08-01). fx·fy = PC 마우스 패럴럭스 계수(±10px 이내, 유지).
   i = myths.items 인덱스. */
const faqRows = [
  [
    { i: 1, dy: 24, fx: -0.7, fy: 0.6, mo: 'l' }, // 불치병이다
    { i: 3, dy: 64, fx: 0.9, fy: -0.5, mo: 'r' }, // 유전병이다
    { i: 4, dy: 0, fx: 0.5, fy: 0.9, mo: 'l' }, // 전염된다
  ],
  [
    { i: 0, dy: 0, fx: -0.9, fy: -0.6, mo: 'r' }, // 단순한 미용 문제다
  ],
  [
    { i: 2, dy: 0, fx: 0.6, fy: -0.8, mo: 'l' }, // 한번 생기면 계속 번진다
    { i: 5, dy: 36, fx: -0.5, fy: 0.8, mo: 'r' }, // 피해야 할 음식이 있다
  ],
];

---

<div class:list={['vta-root', initial && 'animate-fade-up']} data-vta-about-root>
  <section class="vta-section vta-s1 bleed vta-reveal" data-vta-about-section="1">
    <div class="wrapper vta-layer">
      <div class="vta-split-head">
        <div>
          <p class="vta-kicker">{aboutEyebrow}</p>
          <h2 class="vta-title vta-title-s1">
            <span class="font-semibold">{content.intro.titleLines[0]}</span><br />
            <span class="font-normal">{content.intro.titleLines[1]}</span>
          </h2>
        </div>
        <p class="vta-body vta-s1-body vt-left-copy">{content.intro.body}</p>
      </div>
      <div class="vta-photo-strip" data-vta-photo-strip>
        {
          content.intro.images.map((image, index) => (
            <button
              type="button"
              class="vta-photo"
              data-vta-photo
              aria-label={`${index + 1}번째 사진, ${image.alt} 확대 보기`}
              aria-pressed="false"
            >
              <img
                src={image.src}
                alt={image.alt}
                data-vt-hero-target={index === 0 ? true : undefined}
                width="350"
                height="300"
                loading="lazy"
                decoding="async"
              />
              <span class="vta-ph-ov" aria-hidden="true" />
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="vta-section vta-s2 bleed" data-vta-about-section="2">
    <picture class="vta-s2-picture">
      <source media="(max-width: 767px)" srcset="/images/vitiligo/about/04-2-백반증이란-mo.png" />
      <img class="vta-s2-bg" src="/images/vitiligo/about/04-2-백반증이란.png" alt={content.earlySigns.background.alt}
        width="2560" height="800" loading="lazy" decoding="async" />
    </picture>
    <div class="wrapper vta-reveal">
      <div class="vta-half-copy">
        <p class="vta-kicker vta-kicker-white">{aboutEyebrow}</p>
        <h2 class="vta-title vta-s2-title">{content.earlySigns.titleLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>
        <p class="vta-body vta-s2-copy vt-left-copy" data-line-count={content.earlySigns.bodySegments.length}>
          {content.earlySigns.bodySegments.map((line) => <span>{line.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</span>)}
        </p>
      </div>
    </div>
  </section>

  <section class="vta-section vta-differentiation bleed vta-reveal" data-vta-about-section="3">
    <div class="wrapper vta-differentiation-grid">
      <header>
        <p class="vta-kicker">{aboutEyebrow}</p>
        <h2 class="vta-title">{content.differentiation.titleLines.map((line) => <span>{line}</span>)}</h2>
      </header>
      <div>
        <ul class="vta-check-list">
          {content.differentiation.items.map((item) => <li>
            <img src={content.differentiation.checkIconSrc} alt="" width="30" loading="lazy" />
            <p>{item}</p>
          </li>)}
        </ul>
        <aside class="vta-notice">
          <img src={`${aboutImages}/svg/notice-light.svg`} alt="" width="32" loading="lazy" />
          <p>{content.differentiation.noticeLines.map((line, i) => <>{i > 0 && ' '}<span>{line}</span></>)}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="vta-section vta-s3 bleed vta-reveal" data-vta-about-section="4">
    <div class="wrapper">
      <header class="vta-centered-head">
        <p class="vta-kicker">{aboutEyebrow}</p>
        <h2 class="vta-title">{content.causes.titleLines.join(" ")}</h2>
        <p class="vta-body">
          {content.causes.leadLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}
        </p>
      </header>
      <div class="vta-cause-grid" id="vta-causes-rail">
        {
          causes.items.map((it, i) => (
            <article class="vta-cause-card" data-vta-slide>
              <span class="vta-cause-icon" aria-hidden="true">
                <img src={content.causes.icons[it.term]} alt="" width="84" loading="lazy" decoding="async" />
              </span>
              <div>
                <h3>
                  {it.term}
                  {it.term === '외부 자극' && <span> ({koebner.label})</span>}
                </h3>
                <p>{it.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
      <div class="vta-pager">
        <PagingIndicator total={causes.items.length} controls="vta-causes-rail" scrollRailId="vta-causes-rail" slideSelector="[data-vta-slide]">
          <span class="vta-pager-count" aria-hidden="true"><span data-paging-current>1</span> / <span data-paging-total>{causes.items.length}</span></span>
          <span class="sr-only" role="status" aria-live="polite" data-paging-status></span>
        </PagingIndicator>
      </div>
    </div>
  </section>

  <div class="vta-section-wrap vta-s4-wrap vta-reveal" data-vta-about-section="5">
    <VtaTypeCardsSection no={5} hideBadge aboutLayout="body"
      kicker={aboutEyebrow} title={content.types.titleLines.join(' ')} intro={content.types.leadLines}
      vividFigures items={types.items.map((it, i) => ({ ...it, eyebrow: `SUBTYPE ${String(i + 1).padStart(2, '0')}` }))} />
  </div>

  <div class="vta-s5-wrap bleed vta-reveal" data-vta-about-section="6">
    <VtaTypeCardsSection no={6} hideBadge aboutLayout="face"
      kicker={aboutEyebrow} title={content.faces.titleLines.join(' ')} intro={content.faces.leadLines}
      items={faceItems.map((it, i) => ({ ...it, term: it.ko, eyebrow: `SUBTYPE ${String(i + 1).padStart(2, '0')}` }))} />
  </div>

  <section class="vta-section vta-goals bleed vta-reveal" data-vta-about-section="7"
    style={{ backgroundImage: `url("${aboutImages}/04-7-백반증치료의 목표.png")` }}>
    <div class="wrapper">
      <header class="vta-centered-head">
        <p class="vta-kicker">{aboutEyebrow}</p>
        <h2 class="vta-title">{content.goals.titleLines.join(' ')}</h2>
        <p class="vta-body">{content.goals.leadLines.join(' ')}</p>
      </header>
      <div class="vta-goal-grid" id="vta-goals-rail">
        {content.goals.items.map((item, i) => <article class="vta-goal-card" data-vta-slide>
          <div class="vta-goal-image">
            <img src={`${aboutImages}/04-7-백반증이란-${i + 1}.png`} alt={item.image?.alt ?? item.title} width="1200" height="800" loading="lazy" decoding="async" />
          </div>
          <div class="vta-goal-copy">
            <span class="vta-goal-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.bodyLines.map((line) => <span>{line}</span>)}</p>
          </div>
        </article>)}
      </div>
      <div class="vta-pager">
        <PagingIndicator total={content.goals.items.length} controls="vta-goals-rail" scrollRailId="vta-goals-rail" slideSelector="[data-vta-slide]">
          <span class="vta-pager-count" aria-hidden="true"><span data-paging-current>1</span> / <span data-paging-total>{content.goals.items.length}</span></span>
          <span class="sr-only" role="status" aria-live="polite" data-paging-status></span>
        </PagingIndicator>
      </div>
      <aside class="vta-goal-notice">
        <h3>{content.goals.notice.title}</h3>
        <p>{content.goals.notice.bodyLines.map((line) => <span>{line}</span>)}</p>
      </aside>
    </div>
  </section>

  {/* ═══ §6 백반증의 오해와 진실 — #F4F5F6 풀블리드, 둥실 FAQ 박스(클릭 확장·× 닫기) ═══ */}
  <section class="vta-section vta-s6 bleed vta-reveal" data-vta-about-section="8">
    <div class="wrapper">
      <div class="text-center">
        <p class="vta-kicker">{aboutEyebrow}</p>
        <h2 class="vta-title break-keep">{content.myths.titleLines.join(" ")}</h2>
      </div>
      <VitiligoFloatingField mode="free" class="vta-faq-field mt-[60px] max-md:mt-10">
        {
          faqRows.map((row, ri) => (
            <div class:list={['vta-faq-row', `vta-faq-row-${ri + 1}`]}>
              {row.map((f) => {
                const item = myths.items[f.i]!;
                return (
                  <div
                    class:list={['vta-faq-item', f.mo === 'l' ? 'vta-mo-l' : 'vta-mo-r']}
                    style={`--dy:${f.dy}px`}
                  >
                    <div class="vta-faq-par" data-vta-par data-fx={f.fx} data-fy={f.fy}>
                      <div class="vta-faq-box" data-vta-faq>
                        <button
                          type="button"
                          id={`vta-faq-t-${f.i}`}
                          class="vta-faq-toggle"
                          aria-expanded="true"
                          aria-controls={`vta-faq-p-${f.i}`}
                        >
                          <span class="vta-faq-q">{item.q}</span>
                          <span class="vta-faq-x" aria-hidden="true">
                            <img src="/images/vitiligo/about/myths-close.svg" alt="" width="23" height="23" />
                          </span>
                        </button>
                        <div
                          class="vta-faq-a"
                          id={`vta-faq-p-${f.i}`}
                          data-vta-faq-panel
                          role="region"
                          aria-labelledby={`vta-faq-t-${f.i}`}
                        >
                          <div class="vta-faq-a-in">
                            <p class="vta-body break-keep">{item.a}</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          ))
        }
      </VitiligoFloatingField>
    </div>
  </section>

  {/* ═══ §7 진단(07) — 구 G·H 통합(원장 지시 2026-07-31). 레이아웃 = 연구 소개 탭
      (VitiligoResearchPanel) 문법: PC 좌 [뱃지 07 + 헤드라인 + 서브카피] sticky
      (top = 헤더 + 탭 바 + 여백 — research 와 동일 공식) | 우 진단 도구 리스트 7,
      모바일 상하 스택. 우측 리스트 상단 = 제목 상단 정렬(§1 관용구: 뱃지 25px + 8px 보정).
      텍스트는 vitiligo_sections.json 원문 그대로(신규 문구 없음).
      우측 리스트 = 배타 아코디언(원장 지시 2026-08-01 "닫혀 있고, 클릭하면 열리고, 다른 거
      클릭하면 나머진 닫히고") — 공용 FaqAccordion 관용구(grid-rows 0fr↔1fr·aria-expanded·
      셰브론 180° 회전) 이식, 리스트 자체 스타일(research 리듬·번호 열)은 유지.
      no-JS = 전부 펼침 렌더(aria-expanded=true), JS 가 잡으면 전환 없이 전부 닫고 시작 ═══ */}
  <section class="vta-section vta-s7 bleed vta-reveal" data-vta-about-section="9">
    <div class="wrapper vta-s7-grid">
      <header>
        <p class="vta-kicker">{aboutEyebrow}</p>
        <h2 class="vta-title">{content.diagnosis.titleLines.join(" ")}</h2>
        <p class="vta-body vta-s7-copy vt-left-copy">
          {content.diagnosis.leadLines.map((line) => <span>{line}</span>)}
        </p>
      </header>
      <ol class="vta-diag-list" data-vta-diag>
        {
          diagItems.map((it, i) => (
            <li>
              <h3>
                <button
                  type="button"
                  id={`vta-diag-t-${i}`}
                  data-vta-diag-t
                  aria-expanded="true"
                  aria-controls={`vta-diag-p-${i}`}
                  class="vta-diag-toggle"
                >
                  <span class="vta-diag-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="vta-diag-term">{it.term}</span>
                  <span class="vta-diag-ch" aria-hidden="true"></span>
                </button>
              </h3>
              <div
                class="vta-diag-p"
                id={`vta-diag-p-${i}`}
                data-vta-diag-panel
                role="region"
                aria-labelledby={`vta-diag-t-${i}`}
              >
                <div class="vta-diag-overflow">
                  <div class="vta-diag-detail">
                    <p class="vta-body break-keep">{it.desc}</p>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="vta-section vta-activity bleed vta-reveal" aria-labelledby="vta-activity-title">
    <div class="wrapper vta-activity-grid">
      <header>
        <p class="vta-kicker">Activity Signs</p>
        <h2 id="vta-activity-title" class="vta-title vta-added-title">지금 번지고 있는지<br />살펴보는 네 가지 단서</h2>
        <p class="vta-body">
          새 병변이 생기거나 기존 병변의 경계가 달라진다면 백반증이 활동 중일 수 있습니다. 색소회복 치료에 앞서 진행을 안정시키는 치료가 필요한지 확인해야 합니다.
        </p>
      </header>
      <ol class="vta-activity-list">
        <li>
          <span aria-hidden="true">01</span>
          <div><h3>새 반점과 작은 흰 점</h3><p>이전에 없던 반점이나 기존 병변 주변에 종이조각처럼 작은 흰 점이 생기는지 봅니다.</p></div>
        </li>
        <li>
          <span aria-hidden="true">02</span>
          <div><h3>흐려지는 경계와 삼색 변화</h3><p>병변 가장자리가 뿌옇게 흐려지거나 정상 피부와 흰 반점 사이에 중간 색조가 나타나는지 살핍니다.</p></div>
        </li>
        <li>
          <span aria-hidden="true">03</span>
          <div><h3>마찰과 상처 자리</h3><p>긁힌 곳, 허리띠·마스크·신발처럼 반복해 닿는 곳에 새 병변이 생기면 활동성의 단서가 될 수 있습니다.</p></div>
        </li>
        <li>
          <span aria-hidden="true">04</span>
          <div><h3>한 달에 한 번 같은 사진</h3><p>같은 장소·밝기·각도·거리로 촬영해 두면 기억만으로는 놓치기 쉬운 작은 변화를 비교할 수 있습니다.</p></div>
        </li>
      </ol>
    </div>
  </section>

  <VitiligoRelatedColumns sectionId={section.id} eyebrow={aboutEyebrow} />

</div>

<style>
  .vta-root {
    --vta-sp: 140px;
    color: var(--color-ink);
  }
  .vta-section {
    position: relative;
    padding-block: 140px;
  }
  .vta-kicker {
    margin: 0 0 20px;
    color: #6899C0;
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
  }
  .vta-title {
    margin: 0;
    color: var(--color-ink);
    font-size: 40px;
    font-weight: 600;
    line-height: 60px;
  }
  .vta-activity { background: #eef5f8; }
  .vta-activity .vta-added-title { color: #365f78; }
  .vta-activity .vta-kicker,
  .vta-activity-list li > span { color: #3f6f90; }
  .vta-activity-grid { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: clamp(4rem, 9vw, 9rem); }
  .vta-activity-grid > header { align-self: start; position: sticky; top: calc(var(--header-h) + 5.5rem); }
  .vta-activity-grid > header .vta-body { margin-top: 30px; max-width: 31rem; line-height: 2; }
  .vta-activity-list { border-top: 1px solid rgba(41, 42, 43, .28); }
  .vta-activity-list li { display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 22px; padding-block: 30px; border-bottom: 1px solid rgba(41, 42, 43, .28); }
  .vta-activity-list li > span { padding-top: 4px; font-size: 13px; font-weight: 700; letter-spacing: .08em; }
  .vta-activity-list h3 { font-size: 21px; font-weight: 600; line-height: 1.5; }
  .vta-activity-list p { margin-top: 9px; color: #59636a; font-size: 15px; line-height: 1.85; word-break: keep-all; }
  @media (max-width: 767px) {
    .vta-activity-grid { grid-template-columns: 1fr; gap: 52px; }
    .vta-activity-grid > header { position: static; }
    .vta-activity-list li { grid-template-columns: 38px minmax(0, 1fr); gap: 14px; padding-block: 25px; }
    .vta-activity-list h3 { font-size: 18px; }
  }
  .vta-body {
    margin: 0;
    color: var(--color-ink);
    font-size: 18px;
    font-weight: 400;
    line-height: 32px;
  }
  .vta-s1 {
    isolation: isolate;
  }
  .vta-s1::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: radial-gradient(
      37.6% 45.86% at 49.12% 100%,
      #C3DEF1 0%,
      #FFFFFF 100%
    );
    content: '';
    transform: rotate(180deg);
  }
  .vta-layer {
    position: relative;
  }
  .vta-split-head {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .vta-title-s1 {
    font-weight: 400;
  }
  .vta-s1-body {
    align-self: start;
    padding-top: 48px;
    font-size: 20px;
    line-height: 36px;
  }
  .vta-photo-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 90px;
    overflow: hidden;
    border-radius: 20px;
  }
  .vta-photo {
    position: relative;
    display: block;
    aspect-ratio: 350 / 300;
    min-width: 0;
    overflow: hidden;
    cursor: pointer;
  }
  .vta-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 모션 사다리(원장 지시 2026-09-04): 손끝에 반응해 확대되는 것 = --motion-lift(종전 600ms). */
    transition: transform var(--motion-lift) var(--ease-editorial);
  }
  .vta-ph-ov {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.3);
    opacity: 1;
    pointer-events: none;
    /* 같은 hover 안이라도 투명도만 바뀌는 어둠막은 --motion-tint 다(종전 500ms).
       사진은 --motion-lift 로 계속 열리고, 어둠은 먼저 걷혀 사진이 빨리 드러난다. */
    transition: opacity var(--motion-tint) var(--ease-editorial);
  }
  .vta-photo.is-active .vta-ph-ov,
  .vta-photo:hover .vta-ph-ov,
  .vta-photo:focus-visible .vta-ph-ov {
    opacity: 0;
  }
  .vta-photo.is-active img,
  .vta-photo:hover img,
  .vta-photo:focus-visible img {
    transform: scale(1.12);
  }
  .vta-photo:focus-visible {
    z-index: 1;
    outline: 3px solid var(--color-ink);
    outline-offset: -3px;
  }

  /* 배경 이미지의 본래 비율이 사진 영역의 높이를 정한다. */
  .vta-s2 { position: relative; isolation: isolate; padding-block: 0; }
  .vta-s2-bg { display: block; width: 100%; height: auto; }
  .vta-s2 > .wrapper {
    position: absolute; inset: 0; z-index: 1; display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)); padding-block: 140px;
  }
  .vta-half-copy {
    grid-column: 2;
  }
  .vta-kicker-white {
    color: #FFFFFF;
  }
  .vta-kicker-white,
  .vta-s2-title,
  .vta-s2-copy {
    filter: none;
    text-shadow: none;
  }
  .vta-s2-copy {
    margin-top: 90px;
  }
  .vta-s2-copy span {
    display: block;
  }
  .vta-s2-copy strong {
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .vta-s3 {
    background: linear-gradient(180deg, #F2F8FC 0%, #C6DCEA 100%);
  }
  .vta-centered-head {
    text-align: center;
  }
  .vta-centered-head .vta-body {
    margin-top: 30px;
  }
  .vta-cause-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px;
    margin-top: 60px;
  }
  .vta-cause-card {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 230px;
    padding: 40px 30px 40px 210px;
    border-radius: 20px;
    background: #FFFFFF;
  }
  .vta-cause-icon {
    position: absolute;
    top: 50%;
    left: 30px;
    display: grid;
    place-items: center;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: #DFECF6;
    transform: translateY(-50%);
  }
  .vta-cause-icon img { width: 84px; height: auto; }
  .vta-cause-card h3 {
    font-size: 24px;
    font-weight: 600;
    line-height: 32px;
  }
  /* 넘버링은 모바일 세로 카드 전용 — PC 알약 카드는 종전 그대로 이름부터 시작한다 */
  .vta-cause-no {
    display: none;
  }
  .vta-cause-card h3 span {
    color: #7C8288;
    font-weight: 500;
  }
  .vta-cause-card p {
    margin-top: 15px;
    font-size: 18px;
    font-weight: 400;
    line-height: 32px;
  }

  .vta-s4-wrap, .vta-s5-wrap { padding-block: 140px; }
  .vta-s5-wrap { background: #F2F8FC; }

  .vta-s6 {
    padding-block: 140px;
    background: #F4F5F6;
  }
  .vta-s6 .vta-faq-field {
    margin-top: 90px;
  }
  .vta-faq-field {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .vta-faq-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 24px;
  }
  .vta-faq-row-1 {
    justify-content: space-between;
    padding-inline: 3%;
  }
  .vta-faq-row-2 {
    padding-left: 9%;
  }
  .vta-faq-row-3 {
    justify-content: center;
    column-gap: 16%;
  }
  /* 정적 폴백 배치(no-JS·reduced-motion) — 행 흐름 + --dy 지그재그 오프셋 그대로 */
  .vta-faq-item {
    margin-top: var(--dy, 0px);
  }
  /* 자유 부유 모드(원장 지시 2026-08-01 "위치 랜덤·천천히 계속 이동") — JS 가 필드에
     .vta-free 를 붙이고 정적 실측 높이를 인라인 고정(주변 레이아웃 시프트 없음)한 뒤
     항목을 절대배치로 전환, rAF 1루프가 translate3d 만 구동(will-change 금지 규약 준수,
     트랜지션 없이 프레임 단위 이동). 확장 박스는 is-top 으로 최상위 */
  .vta-faq-field.vta-free {
    position: relative;
  }
  .vta-faq-field.vta-free .vta-faq-row {
    display: contents;
  }
  .vta-faq-field.vta-free .vta-faq-item {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
  }
  .vta-faq-field.vta-free .vta-faq-item.is-top {
    z-index: 5;
  }
  /* 패럴럭스 레이어(JS가 transform 부여 — 부유·확장과 분리, 별도 규칙 불요) */
  .vta-faq-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 29.55px 41.38px;
    background: #fff;
    box-shadow: 0 5.91px 91.03px rgb(90 109 123 / 0.3);
    border-radius: 29.55px;
    /* 칸 전체가 클릭 대상(원장 지시 2026-08-01) — 여백을 눌러도 열리므로 커서도 박스 전체에.
       열린 뒤에는 본문 읽기·선택이 주 동작이라 기본 커서로 되돌린다(아래 규칙) */
    cursor: pointer;
  }
  .vta-faq-box.is-open {
    cursor: default;
  }
  .vta-faq-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14.78px;
    cursor: pointer;
    color: var(--color-ink);
  }
  .vta-faq-q {
    font-size: 24px;
    font-weight: 600;
    line-height: 30px;
  }
  .vta-faq-x {
    display: grid;
    width: 0;
    height: 0;
    place-items: center;
    flex: 0 0 auto;
    opacity: 0;
    overflow: hidden;
    /* 원장 피드백 2026-07-30: 클릭 확장은 조금 더 서서히 — 기존 0.35s의 ~1.85배 */
    transition:
      width 0.65s var(--ease-editorial),
      height 0.65s var(--ease-editorial),
      opacity 0.65s var(--ease-editorial);
  }
  .vta-faq-box.is-open .vta-faq-x {
    width: 44px;
    height: 44px;
    opacity: 1;
  }
  .vta-faq-x img {
    display: block;
    width: 23px;
    height: 23px;
  }
  /* 본문 펼침 — grid 0fr→1fr(가로·세로 동시 보간, 주변 박스도 부드럽게 비켜남).
     원장 피드백 2026-07-30: 클릭 시 조금 더 서서히 커지게 — 0.5s → 0.9s(~1.8배).
     주변 박스 밀림도 이 grid 보간이 구동하므로 함께 느려진다. 둥실·패럴럭스 속도 불변 */
  .vta-faq-a {
    display: grid;
    grid-template-rows: 1fr;
    grid-template-columns: 1fr;
    margin-top: 14.78px;
  }
  .vta-faq-field.vta-faq-animate .vta-faq-a {
    transition:
      grid-template-rows 0.9s var(--ease-editorial),
      grid-template-columns 0.9s var(--ease-editorial),
      margin-top 0.9s var(--ease-editorial);
  }
  .vta-faq-a-in {
    overflow: hidden;
    min-height: 0;
    min-width: 0;
  }
  .vta-faq-a-in p {
    width: 480px;
    text-align: left;
  }
  .vta-faq-ready .vta-faq-box:not(.is-open) .vta-faq-a {
    grid-template-rows: 0fr;
    grid-template-columns: 0fr;
    margin-top: 0;
  }
  .vta-faq-box.is-open .vta-faq-a {
    grid-template-rows: 1fr;
    grid-template-columns: 1fr;
    margin-top: 14.78px;
  }
  @media (max-width: 767px) {
    .vta-faq-field {
      gap: 20px;
    }
    .vta-faq-row {
      display: contents;
    }
    .vta-faq-item {
      margin-top: 0;
      max-width: 100%;
    }
    .vta-mo-l {
      align-self: flex-start;
      margin-left: 2%;
    }
    .vta-mo-r {
      align-self: flex-end;
      margin-right: 2%;
    }
    .vta-faq-box {
      padding: 20px 28px;
      border-radius: 22px;
    }
    .vta-faq-q {
      font-size: 18px;
      line-height: 26px;
    }
    .vta-faq-a-in p {
      /* min() 캡 — 767px 경계에서 619px까지 커져 이웃 박스와 겹치는 것 방지(코드검수) */
      width: min(420px, calc(100vw - 148px));
    }
  }

  /* 이 섹션만 흰 바탕(원장 지시 2026-08-07) — 이 항목은 모바일 지시 중 유일하게 PC 도 동일 */
  .vta-s7 {
    background: #FFFFFF;
  }
  .vta-s7-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .vta-s7-grid > header {
    padding-right: 0;
  }
  .vta-s7-copy {
    margin-top: 30px;
  }
  .vta-s7-copy span {
    display: block;
  }
  .vta-diag-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .vta-diag-list > li {
    width: 700px;
    max-width: 100%;
    min-height: 72px;
    overflow: hidden;
    border-radius: 36px;
    background: #FFFFFF;
    box-shadow: 0px 6px 21.5px rgba(157, 173, 185, 0.25);
  }
  .vta-diag-list h3 {
    margin: 0;
  }
  .vta-diag-toggle {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 12px;
    align-items: center;
    gap: 16px;
    width: 100%;
    height: 72px;
    padding: 0 26px 0 15px;
    cursor: pointer;
    text-align: left;
  }
  .vta-diag-num {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 50%;
    background: #EBF5FC;
    color: #6899C0;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
  }
  .vta-diag-term {
    color: var(--color-ink);
    font-size: 18px;
    font-weight: 600;
    line-height: 28px;
  }
  .vta-diag-ch {
    width: 12px;
    height: 8px;
    color: #6899C0;
    /* 곡선만 통일 — 엑시머 패널의 같은 아코디언 표식(+/−)이 이미 350ms var(--ease-editorial)
       이라 시간은 맞는데 여기만 ease-out 리터럴이었다. 사이트 곡선은 --ease-editorial 하나다. */
    transition: transform 350ms var(--ease-editorial);
  }
  .vta-diag-p {
    display: grid;
    grid-template-rows: 1fr;
  }
  .vta-diag-overflow {
    min-height: 0;
    overflow: hidden;
  }
  .vta-diag-detail {
    margin: 0 15px 15px;
    padding: 20px 24px;
    border-radius: 24px;
    background: #FAF9F8;
  }
  .vta-diag-ready .vta-diag-p {
    transition: grid-template-rows 500ms var(--ease-editorial);
  }
  /* 버튼이 h3 안이라 형제 선택자가 패널에 닿지 않는다 — JS 가 li 에 is-open 을 함께
     토글하고 CSS 는 li 상태로 구동(aria-expanded 는 접근성 상태 전용) */
  [data-vta-diag].vta-diag-ready li:not(.is-open) .vta-diag-p {
    grid-template-rows: 0fr;
  }
  @media (max-width: 767px) {
    /* ── 모바일 공통 규격(원장 확정 2026-08-07) — 값은 src/styles/vitiligo.css `.vt-scope`
       소유다. 부제 18/24 · 제목 28/40 · 내용 16/26, 부제↔제목 16 · 제목↔내용 30(좌측)·
       20(가운데) · 내용↔이미지 40 · 섹션 상하 90 · 박스 radius 16.
       여기서 숫자를 다시 적지 않는다 — 값 변경은 vitiligo.css 한 곳에서만.
       var() 폴백을 함께 두는 이유 = .vt-scope 가 아직 안 붙은 렌더에서도 종전값이 아니라
       확정 규격으로 떨어지게 하려는 것(Tailwind 4 트리셰이킹과 무관한 평범한 CSS 변수). ── */
    /* 섹션 상하 여백 — 이번 지시 범위(§1·§3·§7)만 건다. §2 는 배경 레이어가 패딩까지
       덮어야 해서 여백을 안쪽 .wrapper 가 갖고(위 규칙 padding-block:0), §6 은 다른 트랙
       소유라 종전 140 그대로다. `.vta-section` 을 통째로 바꾸면 이 둘까지 끌려온다. */
    .vta-s1,
    .vta-s3,
    .vta-s7 {
      padding-block: var(--vt-section-pad, 90px);
    }
    /* 좌우 여백 30 — 전역 `.wrapper` 는 모바일 20 이라, 지시가 못박은 330 폭 박스
       (§1 사진 프레임 · §7 아코디언)만 가운데 정렬로 30 이 되고 본문 텍스트는 20 에 남아
       시안에 없는 10px 단차가 생겼다. 이 패널 안에서만 30 으로 맞춘다(전역 wrapper 불변).
       ⚠️ §2 는 배경 레이어가 이 wrapper 안에 있고 세로 여백도 여기서 준다 — 함께 30 이 된다. */
    .vta-section > .wrapper {
      padding-inline: var(--vt-gutter, 30px);
    }
    .vta-title {
      font-size: var(--vt-title-size, 28px);
      line-height: var(--vt-title-leading, 40px);
      color: var(--vt-ink, #292a2b);
    }
    .vta-body {
      font-size: var(--vt-body-size, 16px);
      line-height: var(--vt-body-leading, 26px);
      color: var(--vt-ink, #292a2b);
    }
    /* 부제 색은 브랜드색이지만 §2 의 흰 부제(.vta-kicker-white)는 예외 — 같은 특이도라
       뒤에 오는 이 규칙이 이겨 흰색이 지워진다. :not() 으로 명시적으로 비켜 간다. */
    .vta-kicker {
      margin-bottom: var(--vt-gap-kicker-title, 16px);
      font-size: var(--vt-kicker-size, 18px);
      line-height: var(--vt-kicker-leading, 24px);
    }
    .vta-kicker:not(.vta-kicker-white) {
      color: var(--vt-brand, #6899c0);
    }
    .vta-split-head,
    .vta-s2 > .wrapper,
    .vta-s7-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* ── §1 ── */
    /* 배경 — 브랜드 블루가 우상단에서 피어나 좌하로 흰색이 된다. ::before 에 이미
       rotate(180deg)가 걸려 있어 지시 원문의 `at 0% 100%`(좌하)가 화면에선 우상단이 된다.
       세로 반경만 % 대신 vw 인 이유: 섹션 높이가 본문 길이에 따라 달라져 %로는 퍼짐이
       흔들린다. 참고 시안 실측(390 기준 가로 265px·세로 268px 안에서 흰색 도달)과 일치. */
    .vta-s1::before {
      background: radial-gradient(67.95% 68.64vw at 0% 100%, #C3DEF1 0%, #FFFFFF 100%);
    }
    .vta-s1-body {
      margin-top: var(--vt-gap-title-body, 30px);
      padding-top: 0;
    }
    /* 사진 — 165×130 넉 장이 2열 2행, 전체 프레임 330×260(원장 확정 2026-08-07).
       확대·오버레이 호버/포커스 규칙은 PC 그대로 살아 있다(위 .vta-photo 블록). */
    .vta-photo-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 330px;
      max-width: 100%;
      margin-top: var(--vt-gap-body-media, 40px);
      margin-inline: auto;
      border-radius: var(--vt-radius, 16px);
    }
    .vta-photo {
      aspect-ratio: 165 / 130;
    }

    .vta-s2 > .wrapper { padding-block: 280px var(--vt-section-pad, 90px); }
    .vta-half-copy {
      grid-column: 1;
    }
    .vta-s2-copy {
      margin-top: var(--vt-gap-title-body, 30px);
    }

    /* ── §3 — 참고 시안: 세로 카드 가로 스크롤(가운데 스냅·좌우 이웃 걸침).
       카드 240 고정폭 / 간격 16 / 안쪽 여백 좌우 20·상하 25.
       원형 100 안에 아이콘 60, 넘버링 14/20 브랜드색, 제목 22/28, 내용 14/22.
       간격은 원형↔제목 20 · 넘버링↔제목 6 · 제목↔내용 12. ── */
    /* 가운데 정렬 머리글이라 제목↔내용은 center 토큰(20) */
    .vta-centered-head .vta-body {
