---
import type { VitiligoBlock, VitiligoSection } from '../../lib/types';
import { localeOf, localeUrl } from '../../lib/i18n';
import MedicationNumber from './MedicationNumber.astro';
import PagingIndicator from '../ui/PagingIndicator.astro';
import VitiligoFloatingField from './VitiligoFloatingField.astro';
import VitiligoRelatedColumns from './VitiligoRelatedColumns.astro';

interface Props {
  section: VitiligoSection;
  initial: boolean;
  variant?: 'surgery' | 'medication' | 'depigmentation' | 'care';
}

type ProseBlock = Extract<VitiligoBlock, { type: 'prose' }>;
type CalloutBlock = Extract<VitiligoBlock, { type: 'callout' }>;
type DeflistBlock = Extract<VitiligoBlock, { type: 'deflist' }>;
type ListBlock = Extract<VitiligoBlock, { type: 'list' }>;
type StepsBlock = Extract<VitiligoBlock, { type: 'steps' }>;
type FigureBlock = Extract<VitiligoBlock, { type: 'figure' }>;

const { section, initial, variant = 'surgery' } = Astro.props;
const lang = localeOf(Astro.currentLocale);
const surgeryKicker = `힐하우스피부과 ${section.nav_label}`;
const medicationKicker = '힐하우스피부과 약물 치료';
const careKicker = '힐하우스피부과 생활 속 관리';

const medicationCourse = [
  ['활동기', '새 병변과 번지는 속도를 확인해 진행을 줄이는 치료를 우선합니다.'],
  ['회복기', '광선치료 등과 함께 색소회복을 돕도록 부위와 반응에 맞춰 약물 사용을 조정합니다.'],
  ['유지기', '호전된 부위를 관찰하며 필요한 경우 재발을 줄이기 위한 간헐적 치료를 논의합니다.'],
];
const surgeryAftercare = [
  ['초기 보호', '안내받은 기간 동안 마찰과 충격을 피하고 드레싱과 상처 관리를 지킵니다.'],
  ['생착 확인', '딱지와 붉음의 경과를 살피며 이식된 세포가 안정적으로 자리 잡는지 확인합니다.'],
  ['색소 확산', '색소가 점처럼 나타나 주변으로 퍼질 수 있으며 부위에 따라 속도와 균일함이 다릅니다.'],
  ['장기 관찰', '필요하면 광선치료를 병행하고 새로운 병변이나 재발 징후가 없는지 살핍니다.'],
];
const depigmentationDecision = [
  ['적용 대상', '백반증이 매우 넓고 다른 치료로 색소회복을 기대하기 어려운지 전문의 평가가 먼저입니다.'],
  ['되돌리기 어려운 변화', '줄어든 정상 피부의 색은 다시 돌아오지 않을 수 있어 충분한 숙고가 필요합니다.'],
  ['여러 차례의 과정', '한 번에 균일해지는 치료가 아니며 경과를 보면서 나누어 진행할 수 있습니다.'],
  ['지속적인 자외선 보호', '피부색이 줄어든 뒤에는 햇빛에 더 민감해질 수 있어 꾸준한 차단이 중요합니다.'],
];
const careBeyondSkin = [
  ['변화 기록', '한 달에 한 번 같은 장소·밝기·각도·거리로 촬영해 새 병변과 경계 변화를 확인합니다.'],
  ['미용 시술 전 상담', '문신·반영구화장·박피처럼 피부 자극을 주는 시술은 활동성을 고려해 먼저 상담합니다.'],
  ['특정 음식보다 균형', '백반증을 낫게 하거나 모든 환자가 피해야 하는 한 가지 음식은 알려져 있지 않습니다.'],
  ['마음 건강', '시선과 스트레스로 일상이 힘들다면 혼자 견디지 말고 의료진이나 상담 전문가에게 도움을 요청할 수 있습니다.'],
];

const requireProse = (heading: string): ProseBlock => {
  const block = section.blocks.find(
    (candidate): candidate is ProseBlock =>
      candidate.type === 'prose' && candidate.heading === heading,
  );
  if (!block) throw new Error(`Missing surgery prose block: ${heading}`);
  return block;
};

const requireCallout = (label: string): CalloutBlock => {
  const block = section.blocks.find(
    (candidate): candidate is CalloutBlock =>
      candidate.type === 'callout' && candidate.label === label,
  );
  if (!block) throw new Error(`Missing surgery callout block: ${label}`);
  return block;
};

const requireDeflist = (heading: string): DeflistBlock => {
  const block = section.blocks.find(
    (candidate): candidate is DeflistBlock =>
      candidate.type === 'deflist' && candidate.heading === heading,
  );
  if (!block) throw new Error(`Missing surgery definition block: ${heading}`);
  return block;
};

const requireList = (heading: string): ListBlock => {
  const block = section.blocks.find(
    (candidate): candidate is ListBlock =>
      candidate.type === 'list' && candidate.heading === heading,
  );
  if (!block) throw new Error(`Missing surgery list block: ${heading}`);
  return block;
};

const requireFigure = (src: string): FigureBlock => {
  const block = section.blocks.find(
    (candidate): candidate is FigureBlock => candidate.type === 'figure' && candidate.src === src,
  );
  if (!block) throw new Error(`Missing surgery figure block: ${src}`);
  return block;
};

const requireDefinition = (block: DeflistBlock, term: string) => {
  const item = block.items.find((candidate) => candidate.term === term);
  if (!item) throw new Error(`Missing surgery definition item: ${term}`);
  return item;
};

const requireTag = (block: ListBlock, label: string) => {
  const item = block.items.find((candidate) => candidate === label);
  if (!item) throw new Error(`Missing surgery condition tag: ${label}`);
  return item;
};

const splitBefore = (text: string, marker: string, label: string): [string, string] => {
  const index = text.indexOf(marker);
  if (index < 0) throw new Error(`Missing surgery copy marker (${label}): ${marker}`);
  return [text.slice(0, index).trimEnd(), text.slice(index).trimStart()];
};

const surgeryModel = (() => {
  if (variant !== 'surgery') return null;

  const consideration = requireProse('언제 수술을 고려하나요?');
  const stabilityReason = requireCallout('* 안정기를 확인하는 이유');
  const criteria = requireDeflist('수술 고려 기준');
  const methods = requireDeflist('백반증 수술, 어떤 방법으로 하나요?');
  const method01 = requireDefinition(methods, '미세펀치이식술');
  const method02 = requireDefinition(methods, '흡입물집이식술');
  const method03 = requireDefinition(methods, '비배양 표피세포이식술');
  const method01Figure = requireFigure('/images/vitiligo/surgery/method-01.png');
  const aftercare = requireProse('수술 후 경과는 어떤가요?');
  const beforeSurgery = requireCallout('수술 전 알아두기');
  const recurrence = requireCallout('수술과 재발');
  const successConditions = requireList('성공적인 수술적 치료를 위한 조건');

  const tagSegmental = requireTag(successConditions, '분절형 백반증 환자');
  const tagStable = requireTag(successConditions, '1년 이상 안정된 백반증');
  const tagYoung = requireTag(successConditions, '어린 나이');
  const tagLight = requireTag(successConditions, '광선 치료, 레이저 치료 병행');
  const tagFace = requireTag(successConditions, '얼굴과 목 부위');

  const STABLE_PHRASE = '일정 기간 병변의 진행이 멈춘 안정된 백반증';
  const ledeParagraphs = section.lede.split(/\n\s*\n/).map((text) => {
    const phraseAt = text.indexOf(STABLE_PHRASE);
    return phraseAt < 0
      ? { before: text, phrase: '', after: '' }
      : {
          before: text.slice(0, phraseAt),
          phrase: STABLE_PHRASE,
          after: text.slice(phraseAt + STABLE_PHRASE.length),
        };
  });
  const successParagraphs = (successConditions.intro ?? '').split(/\n\s*\n/);
  if (successParagraphs.length !== 3) {
    throw new Error(`Expected three surgery success paragraphs, received ${successParagraphs.length}`);
  }
  const [successOpening, successMiddle, successClosing] = successParagraphs;
  const [successFirstLine, successSecondLine] = splitBefore(
    successOpening,
    '특히 백반증이',
    'success line 2',
  );
  const [stabilityOpening, stabilityClosing] = splitBefore(
    stabilityReason.body_md,
    '분절형은',
    'stability line 2',
  );

  const [considerationOpening, considerationRemainder] = splitBefore(
    consideration.body_md,
    '병변의 진행이',
    'consideration desktop line 2',
  );
  const [considerationMiddle, considerationClosing] = splitBefore(
    considerationRemainder,
    '수술은 특별한 선택이',
    'consideration final sentence',
  );
  const [method01Opening, method01Closing] = splitBefore(
    method01.desc,
    '정상 피부를 옮겨 심으면',
    'method 01 paragraph 2',
  );
  const [aftercareOpening, aftercareClosing] = splitBefore(
    aftercare.body_md,
    '얼굴과 목',
    'aftercare paragraph 2',
  );

  return {
    consideration,
    stabilityReason,
    criteria,
    methods,
    method01,
    method02,
    method03,
    method01Figure,
    aftercare,
    beforeSurgery,
    recurrence,
    successConditions,
    tagSegmental,
    tagStable,
    tagYoung,
    tagLight,
    tagFace,
    ledeParagraphs,
    successFirstLine,
    successSecondLine,
    successMiddle,
    successClosing,
    stabilityOpening,
    stabilityClosing,
    considerationOpening,
    considerationMiddle,
    considerationClosing,
    method01Opening,
    method01Closing,
    aftercareOpening,
    aftercareClosing,
  };
})();

const {
  consideration,
  stabilityReason,
  criteria,
  methods,
  method01,
  method02,
  method03,
  method01Figure,
  aftercare,
  beforeSurgery,
  recurrence,
  successConditions,
  tagSegmental,
  tagStable,
  tagYoung,
  tagLight,
  tagFace,
  ledeParagraphs,
  successFirstLine,
  successSecondLine,
  successMiddle,
  successClosing,
  stabilityOpening,
  stabilityClosing,
  considerationOpening,
  considerationMiddle,
  considerationClosing,
  method01Opening,
  method01Closing,
  aftercareOpening,
  aftercareClosing,
} = surgeryModel ?? ({} as NonNullable<typeof surgeryModel>);

const splitMedicationEmphasis = (text: string, phrase: string, label: string) => {
  const index = text.indexOf(phrase);
  if (index < 0) throw new Error(`Missing medication emphasis (${label}): ${phrase}`);
  return {
    before: text.slice(0, index),
    emphasis: phrase,
    after: text.slice(index + phrase.length),
  };
};

const medicationModel = (() => {
  if (variant !== 'medication') return null;

  const proseBlocks = section.blocks.filter(
    (candidate): candidate is ProseBlock => candidate.type === 'prose',
  );
  const groups = section.blocks.filter(
    (candidate): candidate is DeflistBlock => candidate.type === 'deflist',
  );
  const callouts = section.blocks.filter(
    (candidate): candidate is CalloutBlock => candidate.type === 'callout',
  );
  const lists = section.blocks.filter(
    (candidate): candidate is ListBlock => candidate.type === 'list',
  );

  const intro = proseBlocks[0];
  const topical = groups.find(({ heading }) => heading === '병변에 직접 바르는 연고 치료');
  const oral = groups.find(({ heading }) => heading === '활동기에 짧게 쓰는 먹는 약');
  const systemicNotice = callouts.find(({ label }) => label === '전신 치료 시 주의사항');
  const lightTherapy = callouts.find(({ label }) => label === '광선치료와 함께');
  const precautions = lists.find(({ heading }) => heading === '치료 시 주의사항');

  if (
    proseBlocks.length !== 1 ||
    groups.length !== 2 ||
    callouts.length !== 2 ||
    lists.length !== 1 ||
    !intro ||
    !topical?.intro ||
    topical.items.length !== 2 ||
    !oral?.intro ||
    oral.items.length !== 2 ||
    !systemicNotice ||
    !lightTherapy ||
    !precautions ||
    precautions.items.length !== 4
  ) {
    throw new Error('Missing medication design blocks');
  }

  const topicalTerms = ['스테로이드 연고', '칼시뉴린 억제제'];
  const oralTerms = ['경구 스테로이드 치료', '경구 면역 억제제 치료'];
  if (
    topical.items.some((item, index) => item.term !== topicalTerms[index]) ||
    oral.items.some((item, index) => item.term !== oralTerms[index])
  ) {
    throw new Error('Unexpected medication card order');
  }

  const firstHeroEmphasis = splitMedicationEmphasis(
    intro.body_md,
    '더 번지지 않도록 돕는 것',
    'hero progression',
  );
  const secondHeroEmphasis = splitMedicationEmphasis(
    firstHeroEmphasis.after,
    '색소가 다시 자리 잡을 여건을 만드는 것',
    'hero repigmentation',
  );
  const firstOralCard = {
    ...oral.items[0]!,
    copy: splitMedicationEmphasis(
      oral.items[0]!.desc,
      '급격히 진행되는 백반증 환자에게 효과적입니다.',
      'oral steroid',
    ),
  };
  const secondOralCard = {
    ...oral.items[1]!,
    copy: splitMedicationEmphasis(
      oral.items[1]!.desc,
      '스테로이드를 사용할 수 없는 경우나 다른 치료로 잘 낫지 않는 경우',
      'oral immunosuppressant',
    ),
  };

  return {
    introBefore: firstHeroEmphasis.before,
    introFirstEmphasis: firstHeroEmphasis.emphasis,
    introBetween: secondHeroEmphasis.before,
    introSecondEmphasis: secondHeroEmphasis.emphasis,
    introAfter: secondHeroEmphasis.after,
    topical,
    firstTopicalCard: topical.items[0]!,
    secondTopicalCard: topical.items[1]!,
    oral,
    firstOralCard,
    secondOralCard,
    systemicNotice,
    lightTherapy,
    precautions,
  };
})();

const depigmentationModel = (() => {
  if (variant !== 'depigmentation') return null;

  const proseBlocks = section.blocks.filter(
    (candidate): candidate is ProseBlock => candidate.type === 'prose',
  );
  const calloutBlocks = section.blocks.filter(
    (candidate): candidate is CalloutBlock => candidate.type === 'callout',
  );
  const stepBlocks = section.blocks.filter(
    (candidate): candidate is StepsBlock => candidate.type === 'steps',
  );
  const creamBlocks = section.blocks.filter(
    (candidate): candidate is DeflistBlock => candidate.type === 'deflist',
  );
  const cautionBlocks = section.blocks.filter(
    (candidate): candidate is ListBlock => candidate.type === 'list',
  );

  const intro = proseBlocks[0];
  const callout = calloutBlocks[0];
  const laser = stepBlocks[0];
  const cream = creamBlocks[0];
  const cautions = cautionBlocks[0];
  if (
    proseBlocks.length !== 1 ||
    calloutBlocks.length !== 1 ||
    stepBlocks.length !== 1 ||
    creamBlocks.length !== 1 ||
    cautionBlocks.length !== 1 ||
    !intro?.heading ||
    !callout ||
    !laser?.intro ||
    laser.items.length !== 6 ||
    !cream ||
    cream.items.length !== 1 ||
    cream.items[0]?.term !== 'MBEH 크림' ||
    !cautions ||
    cautions.items.length !== 3
  ) {
    throw new Error('Missing depigmentation design blocks');
  }

  const titleBreakAt = intro.heading.indexOf(',');
  const introEmphasis = '남아 있는 정상 색소를 정리해 피부색을 고르게 하는';
  const introEmphasisAt = intro.body_md.indexOf(introEmphasis);
  if (titleBreakAt < 0 || introEmphasisAt < 0) {
    throw new Error('Missing depigmentation design blocks');
  }

  return {
    intro,
    introTitleOpening: intro.heading.slice(0, titleBreakAt + 1),
    introTitleClosing: intro.heading.slice(titleBreakAt + 1).trimStart(),
    introBefore: intro.body_md.slice(0, introEmphasisAt),
    introEmphasis,
    introAfter: intro.body_md.slice(introEmphasisAt + introEmphasis.length),
    callout,
    laser,
    cream,
    creamItem: cream.items[0]!,
    cautions,
  };
})();

const careModel = (() => {
  if (variant !== 'care') return null;

  const groups = section.blocks.filter(
    (candidate): candidate is DeflistBlock => candidate.type === 'deflist',
  );
  const prose = section.blocks.filter(
    (candidate): candidate is ProseBlock => candidate.type === 'prose',
  );
  const daily = groups.find(({ heading }) => heading === '생활 속 백반증 관리 방법');
  const cover = groups.find(({ heading }) => heading === '가리고 채우는 방법');
  const closing = prose.find(({ heading }) => heading === '백반증 진료와 함께');
  const expectedDaily = ['마찰과 압박 줄이기', '자외선 관리', '금연', '항산화 관리', '면역증강제 주의'];
  const expectedCover = ['커버 화장품', '미세색소주입술', '셀프태닝(DHA) 도포', '속눈썹 염색'];

  if (
    groups.length !== 2 ||
    prose.length !== 1 ||
    !daily?.intro ||
    daily.items.length !== expectedDaily.length ||
    daily.items.some((item, index) => item.term !== expectedDaily[index]) ||
    !cover?.intro ||
    cover.items.length !== expectedCover.length ||
    cover.items.some((item, index) => item.term !== expectedCover[index]) ||
    !closing?.heading
  ) {
    throw new Error('Missing care design blocks');
  }

  const dailyImages = [
    { src: '/images/vitiligo/care/care-01.png', webp: '/images/vitiligo/care/care-01.webp', width: 1918, height: 820 },
    { src: '/images/vitiligo/care/care-02.png', webp: '/images/vitiligo/care/care-02.webp', width: 1918, height: 820 },
    { src: '/images/vitiligo/care/care-03.jpg', webp: '/images/vitiligo/care/care-03.webp', width: 1241, height: 828 },
    { src: '/images/vitiligo/care/care-04.jpg', webp: '/images/vitiligo/care/care-04.webp', width: 1631, height: 1087 },
    { src: '/images/vitiligo/care/care-05.jpg', webp: '/images/vitiligo/care/care-05.webp', width: 1077, height: 1077 },
  ];
  const coverImages = [
    { src: '/images/vitiligo/care/cover-01.png', webp: '/images/vitiligo/care/cover-01.webp', width: 1918, height: 820 },
    { src: '/images/vitiligo/care/cover-02.png', webp: '/images/vitiligo/care/cover-02.webp', width: 1918, height: 820 },
    { src: '/images/vitiligo/care/cover-03.png', webp: '/images/vitiligo/care/cover-03.webp', width: 1918, height: 820 },
    { src: '/images/vitiligo/care/cover-04.png', webp: '/images/vitiligo/care/cover-04.webp', width: 1983, height: 793 },
  ];
  const treatments = [
    {
      label: '백반증 광선치료',
      href: localeUrl(lang, 'vitiligo/excimer/'),
      icon: '/images/vitiligo/care/phototherapy.svg',
      desktopIcon: '/images/vitiligo/care/phototherapy-line.svg',
    },
    {
      label: '백반증 약물치료',
      href: localeUrl(lang, 'vitiligo/medication/'),
      icon: '/images/vitiligo/care/medication.svg',
      desktopIcon: '/images/vitiligo/care/medication-line.svg',
    },
    {
      label: '백반증 수술',
      href: localeUrl(lang, 'vitiligo/surgery/'),
      icon: '/images/vitiligo/care/surgery.svg',
      desktopIcon: '/images/vitiligo/care/surgery-line.svg',
    },
  ];

  const emphasis = '무엇을 피하고 무엇을 챙길지 알아 두면';
  const heroLines = section.lede.split('\n');
  if (heroLines.length !== 3 || !heroLines[2]?.startsWith(emphasis)) {
    throw new Error('Missing care hero copy');
  }

  return {
    daily,
    cover,
    closing,
    dailyImages,
    coverImages,
    treatments,
    heroOpening: heroLines.slice(0, 2),
    heroEmphasis: emphasis,
    heroClosing: heroLines[2].slice(emphasis.length),
    dailyIntro: daily.intro.split('\n'),
    coverIntro: cover.intro.split('\n'),
    closingLines: closing.body_md.split('\n'),
  };
})();
---

{
  careModel && (
    <div class:list={['vts', 'vtc', initial && 'animate-fade-up']} data-vtc-panel>
      <section
        class="vts-band vts-intro vtc-intro bleed"
        data-vtc-section="1"
        aria-labelledby="vtc-intro-title"
      >
        <div class="wrapper--content vts-container vts-section-pad">
          <header class="vts-intro-head vtc-intro-head">
            <div class="vtc-left-copy">
              <p class="vts-kicker">{careKicker}</p>
              <h2
                id="vtc-intro-title"
                class="vts-title vts-title--intro vtc-intro-title"
                set:html={section.title}
              />
            </div>
            <div class="vts-intro-lede vtc-intro-lede">
              <p class="vts-body">
                {careModel.heroOpening.map((line) => (
                  <span class="vtc-copy-line">{line}</span>
                ))}
                <span class="vtc-copy-line">
                  <strong>{careModel.heroEmphasis}</strong>{careModel.heroClosing}
                </span>
              </p>
            </div>
          </header>

          <figure class="vtc-intro-media">
            <picture>
