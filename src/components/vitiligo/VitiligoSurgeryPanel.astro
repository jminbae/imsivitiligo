            </p>
          </PagingIndicator>
        </div>
      </div>
    </div>
  </section>

  <section class="vts-band vts-after bleed" data-vts-section="4" aria-labelledby="vts-after-title">
    <div class="wrapper--content vts-container vts-section-pad">
      <header class="vts-after-head">
