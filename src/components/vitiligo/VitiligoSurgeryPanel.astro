<script>
  import { initEditorialReveal } from '../../lib/editorialReveal.mjs';

  const initSurgeryCarousels = () => {
    const carousels = Array.from(
      document.querySelectorAll<HTMLElement>('[data-vts-method-carousel]'),
    );

    carousels.forEach((carousel) => {
      if (carousel.dataset.vtsCarouselReady === 'true') return;
      carousel.dataset.vtsCarouselReady = 'true';

      const rail = carousel.querySelector<HTMLElement>('[data-vts-method-rail]');
      const current = carousel.querySelector<HTMLElement>('[data-vts-method-current]');
      const total = carousel.querySelector<HTMLElement>('[data-vts-method-total]');
      const status = carousel.querySelector<HTMLElement>('[data-vts-method-status]');
      const previous = carousel.querySelector<HTMLButtonElement>('[data-paging-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-paging-next]');
      if (!rail || !current || !total || !status || !previous || !next) return;

      const slides = Array.from(rail.querySelectorAll<HTMLElement>('.vts-method-card'));
      if (slides.length === 0) return;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let activeIndex = 0;
      let targetIndex: number | null = null;
      let scrollFrame = 0;
      let settleTimer = 0;

      total.textContent = String(slides.length);

      const slidePosition = (slide: HTMLElement) => {
        const inset = Number.parseFloat(getComputedStyle(rail).scrollPaddingLeft) || 0;
        return Math.max(0, slide.offsetLeft - inset);
      };

      const nearestIndex = () => {
        let nearest = 0;
        let distance = Number.POSITIVE_INFINITY;
        slides.forEach((slide, index) => {
          const nextDistance = Math.abs(slidePosition(slide) - rail.scrollLeft);
          if (nextDistance < distance) {
            distance = nextDistance;
            nearest = index;
          }
        });
        return nearest;
      };

      const statusText = (index: number) => `총 ${slides.length}개 중 ${index + 1}번째`;

      const renderIndex = (index: number) => {
        const indexChanged = index !== activeIndex;
        activeIndex = index;
        current.textContent = String(activeIndex + 1);
        if (indexChanged) status.textContent = statusText(activeIndex);
        previous.disabled = activeIndex === 0;
        next.disabled = activeIndex === slides.length - 1;
      };

      renderIndex(activeIndex);
      status.textContent = statusText(activeIndex);

      const update = () => renderIndex(nearestIndex());

      const scrollToSlide = (index: number, behavior?: ScrollBehavior) => {
        const bounded = Math.max(0, Math.min(index, slides.length - 1));
        const resolvedBehavior = behavior ?? (reducedMotion.matches ? 'auto' : 'smooth');
        targetIndex = bounded;
        rail.scrollTo({ left: slidePosition(slides[bounded]!), behavior: resolvedBehavior });
        if (resolvedBehavior === 'auto') {
          targetIndex = null;
          update();
        }
      };

      previous.addEventListener('click', () => scrollToSlide((targetIndex ?? activeIndex) - 1));
      next.addEventListener('click', () => scrollToSlide((targetIndex ?? activeIndex) + 1));

      rail.addEventListener(
        'scroll',
        () => {
          window.clearTimeout(settleTimer);
          settleTimer = window.setTimeout(() => {
            targetIndex = null;
            update();
          }, 120);
          if (scrollFrame) return;
          scrollFrame = requestAnimationFrame(() => {
            scrollFrame = 0;
            update();
          });
        },
        { passive: true },
      );

      let pointerId = -1;
      let dragStartX = 0;
      let dragStartScroll = 0;

      rail.addEventListener('pointerdown', (event) => {
        targetIndex = null;
        if (
          window.matchMedia('(min-width: 768px)').matches ||
          event.pointerType !== 'mouse' ||
          event.button !== 0
        )
          return;
        pointerId = event.pointerId;
        dragStartX = event.clientX;
        dragStartScroll = rail.scrollLeft;
        rail.setPointerCapture(pointerId);
        rail.classList.add('is-dragging');
      });

      rail.addEventListener('pointermove', (event) => {
        if (event.pointerId !== pointerId) return;
        event.preventDefault();
        rail.scrollLeft = dragStartScroll - (event.clientX - dragStartX);
      });

      const finishDrag = (event: PointerEvent) => {
        if (event.pointerId !== pointerId) return;
        if (rail.hasPointerCapture(pointerId)) rail.releasePointerCapture(pointerId);
        pointerId = -1;
        rail.classList.remove('is-dragging');
        scrollToSlide(nearestIndex());
      };

      rail.addEventListener('pointerup', finishDrag);
      rail.addEventListener('pointercancel', finishDrag);
      rail.addEventListener('wheel', () => {
        targetIndex = null;
      }, { passive: true });
      window.addEventListener('resize', update, { passive: true });

      scrollToSlide(0, 'auto');
    });
  };

  const initDepigmentationAccordions = () => {
    const accordions = Array.from(
      document.querySelectorAll<HTMLElement>('[data-vtd-accordion]'),
    );

    accordions.forEach((accordion) => {
      const data = accordion.dataset;
      if (data.vtdAccordionReady === 'true') return;

      const steps = Array.from(accordion.querySelectorAll<HTMLElement>('[data-vtd-step]'));
      const buttons = steps.map((step) =>
        step.querySelector<HTMLButtonElement>('[data-vtd-step-button]'),
      );
      if (steps.length === 0 || buttons.some((button) => !button)) return;
      data.vtdAccordionReady = 'true';

      const mobile = window.matchMedia('(max-width: 767.98px)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let activeIndex: number | null = null;
      let correctionTimer = 0;

      const setActive = (nextIndex: number | null) => {
        if (mobile.matches && nextIndex === activeIndex) return;
        activeIndex = nextIndex;
        steps.forEach((step, index) => {
          const button = buttons[index]!;
          const isActive = index === activeIndex;
          step.classList.toggle('is-active', isActive);
          button.setAttribute('aria-expanded', String(isActive));
          button
            .querySelector<HTMLElement>('.vtd-step-description')
            ?.setAttribute('aria-hidden', String(!isActive));
        });
      };

      const correctMobileScroll = (index: number) => {
        window.clearTimeout(correctionTimer);
        correctionTimer = window.setTimeout(
          () => {
            if (!mobile.matches || activeIndex !== index) return;
            const bounds = buttons[index]!.getBoundingClientRect();
            if (bounds.top < 0 || bounds.bottom > window.innerHeight) {
              buttons[index]!.scrollIntoView({
                behavior: reducedMotion.matches ? 'auto' : 'smooth',
                block: 'nearest',
              });
            }
          },
          reducedMotion.matches ? 0 : 300,
        );
      };

      steps.forEach((step, index) => {
        const button = buttons[index]!;
        step.addEventListener('pointerenter', () => {
          if (!mobile.matches) setActive(index);
        });
        button.addEventListener('focus', () => {
          if (!mobile.matches) setActive(index);
        });
        button.addEventListener('click', () => {
          if (!mobile.matches) return;
          setActive(index);
          correctMobileScroll(index);
        });
      });

      accordion.addEventListener('pointerleave', () => {
        if (!mobile.matches) setActive(null);
      });
      accordion.addEventListener('focusout', (event) => {
        if (mobile.matches) return;
        const nextFocus = event.relatedTarget;
        if (!(nextFocus instanceof Node) || !accordion.contains(nextFocus)) setActive(null);
      });

      const resetForViewport = () => {
        window.clearTimeout(correctionTimer);
        if (mobile.matches) setActive(0);
        else setActive(null);
      };
      mobile.addEventListener('change', resetForViewport);
      resetForViewport();
    });
  };

  const initMedicationReveal = () => {
    const roots = Array.from(
      document.querySelectorAll<HTMLElement>('[data-vtm-reveal-root]'),
    );

    roots.forEach((root) => {
      if (root.dataset.vtmRevealInitialized === 'true') return;
      root.dataset.vtmRevealInitialized = 'true';
      const cleanupReveal = initEditorialReveal({ root, targets: '.vtm-reveal' });
      document.addEventListener('astro:before-swap', cleanupReveal, { once: true });
    });
  };

  initSurgeryCarousels();
  initDepigmentationAccordions();
  initMedicationReveal();
  document.addEventListener('astro:page-load', initSurgeryCarousels);
  document.addEventListener('astro:page-load', initDepigmentationAccordions);
  document.addEventListener('astro:page-load', initMedicationReveal);
</script>
