  },
];

const TREATMENT_GUIDE = [
  {
    title: '새 반점이 생기거나 번질 때',
    body: '병이 활동 중인지 먼저 확인하고, 진행을 줄이기 위한 약물치료와 광선치료의 병행 여부를 살핍니다.',
    href: localeUrl(lang, 'vitiligo/medication/'),
    link: vitiligoSectionLink('medication').label,
  },
  {
