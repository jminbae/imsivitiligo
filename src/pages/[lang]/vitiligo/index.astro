---
import { localeOf, localeUrl, localePaths } from '../../../lib/i18n';
/* 이 페이지의 언어. 메뉴 데이터가 프론트매터 앞쪽에 있어 **맨 위**에 둔다.
   'ko' 를 박지 않는다 — 2단계에서 언어가 늘어도 이 파일은 손대지 않는다. 정본: src/lib/i18n.ts */
const lang = localeOf(Astro.currentLocale);
/* 언어 경로 — 고정 페이지는 언어 목록만 펼친다(콘텐츠와 곱하지 않는다). 정본: src/lib/i18n.ts */
export const getStaticPaths = () => localePaths();
/**
 * /vitiligo/ — 백반증 랜딩 전면 리뉴얼 (원장 지시 2026-07-22 최종).
 * 셸(VitiligoShell)에서 분리한 독립 페이지. 서브 7개 URL은 기존 셸 유지, 이 랜딩만 새 구성.
 * 섹션: 1 Hero(15 변신 시퀀스) → 2 Agitation(검정) → 3 카운트업(검정) → 4 카드 슬라이더(흰)
 *      → 4.5 의사 소개(흰) → 5 후기(흰) → 7 논문(흰).
 * 공통(§A): 전 카피 고딕 · 섹션 구분선 없음 · 검정(2·3)/흰(4~7) 배경 체계 ·
 *          스크롤 연출은 모바일·reduced-motion 정적 폴백.
 * - 상단 고정 카테고리(VitiligoStickyNav)는 히어로에선 숨김 → 검정 밴드 진입 시 등장,
 *   검정/흰 구간 테마 자동 전환. 항목은 기존 서브 라우트로 이동.
 * - #vitiligo-hero id는 [히어로+검정 밴드] 래퍼에 — Header 오버레이 임계가 "어두운 구간 끝"
 *   에서 반전(§교훈: 오버레이 페이지 새 히어로는 반드시 computeThreshold 셀렉터에 등록).
 * - 지표·의사·논문 데이터는 기존 소스 그대로(vitiligo_landing.json·repo).
 * - 후기(§H)는 healhouseskin.com/vitiligo/main.php "백반증센터 고객 리뷰" 22건 이식
 *   (2026-07-22 추출). 프로필 사진은 원본 22장 webp 반입(2026-07-29 13차 3-c,
 *   /images/vitiligo/reviews/ — 원본 순서 = REVIEWS 순서 1:1 확인).
 *   ⚠️ 치료경험담은 의료광고 심의 대상 — 실데이터 운영 시 출처·환자 동의 관리 필요.
 * - PC 개편(원장 지시 2026-07-30 8차, 참고 전달용/00 예시이미지/백반증-pc.png):
 *   수치 밴드 아래 ④~⑦ 전 구간을 md+ 전용 새 구성(Specialty·의사 다크 밴드·ReviewSlider
 *   재사용 후기·인사이트 칼럼+N개 더보기·연구 소개)으로 교체 — 기존 섹션은 md:hidden으로
 *   모바일 전용 유지(모바일 1px 불변). 데이터는 전부 백반증 소스만(REVIEWS·
 *   researchPapers) — 홈 데이터·홈 문구 반입 금지.
 * - ④ Specialty 통합(원장 지시 2026-08-03): 위 두 벌(PC 핀 시퀀스 / 모바일 옛 블록)을
 *   **반응형 한 벌**로 합치고 핀+갈아끼우기 모션을 폐기했다("답답하다" — 스크롤을 잡지 않는다).
 * - ⑦ 연구 소개 통합(원장 지시 2026-08-07): 모바일이 PC 와 같은 개수(5건)·문구
 *   ('연구 소개 더 보기 >')·디자인('백반증이란' 연구 소개)으로 맞춰지며 두 벌을 쓸 이유가
 *   사라져 **반응형 한 벌**이 됐다(옛 모바일 FeedList 10건+더보기 블록 삭제).
 * - ⑤ 후기·⑥ 칼럼 통합(검수 2026-08-11 — 크롤러 이중 렌더 제거, 원장 확정): 마지막까지
 *   두 벌이던 ⑤(ReviewSlider / .vt-slider 커스텀)·⑥(전용 그리드+더보기 / FeedList)을
 *   **반응형 한 벌**로 합쳤다 — ⑤ = ReviewSlider(반응형 내장), ⑥ = FeedList.
 * - 2026-09-15: 메인의 칼럼·진료 안내는 DOM과 전용 데이터 조회·구조화 데이터에서 제거했다.
 *   하위 페이지 탐색은 기존 고정 카테고리 바가 맡고, 연구 소개는 유지한다.
 */
import { readdirSync } from 'node:fs';
import path from 'node:path';
import Base from '../../../layouts/Base.astro';
import SEOHead from '../../../components/SEOHead.astro';
// 히어로 — 스크롤 시퀀스(VitiligoHeroSequence) → 캐러셀 원복(원장 지시 2026-08-02).
// 시퀀스 파일은 2026-09-03 청소로 삭제했다(미배선 사본 보존 금지 — 되돌리기는 git 이력).
import VitiligoHero from '../../../components/vitiligo/VitiligoHero.astro';
import VitiligoStickyNav from '../../../components/vitiligo/VitiligoStickyNav.astro';
import ReviewSlider from '../../../components/home/ReviewSlider.astro';
import ReviewDisclaimer from '../../../components/ui/ReviewDisclaimer.astro';
import {
  getDoctorIdentityBySlug,
  getResearchPapers,
  getVitiligoLanding,
} from '../../../lib/repo';
import { breadcrumbLd, vitiligoPageLd, type Crumb } from '../../../lib/jsonld';
import { VITILIGO_REVIEWER_SLUG, VITILIGO_REVIEWED_AT } from '../../../lib/vitiligoMeta';
import { SITE } from '../../../lib/site';
import { vitiligoSectionLink } from '../../../lib/vitiligo-section-links';
/* 백반증 카테고리 공통 규격 토큰(--vt-*) — 이 랜딩은 셸(VitiligoShell)을 쓰지 않는
   독립 페이지라 여기서 직접 싣는다. import 방식은 저장소 관용구 그대로(전역 CSS 파일을
   프런트매터에서 import). 상속 루트는 아래 .vt-scope 래퍼 한 겹. */
import '../../../styles/vitiligo.css';

const [landing, researchPapers] = await Promise.all([
  getVitiligoLanding(),
  getResearchPapers(),
]);
// ※ landing.pillars·doctor.lede는 구 랜딩 패널 전용이라 현재 미사용(소비처 없음) —
//   vitiligo_landing.json에서 이 두 필드를 수정해도 화면에 반영되지 않는다(코드검수 기록).
/* ④-5 원장 블록 — vitiligo_landing.json 의 doctor 에는 이 페이지 고유 문안(body)·사진만 남는다.
   이름·학회 이력·프로필 주소는 doctors.json(운영앱 입력 → exporter 산출물)의 배정민 행에서
   파생한다(아래 `reviewer`, 원장 결정 2026-09-03 §0-AJ "코드에 박아둔거 지워. 입력한게 맞아.").
   ⚠️ 종전에는 name·role·credentials 사본이 이 JSON 에 박혀 있어 운영앱에서 학회 직함을 고쳐도
      랜딩은 2026-07-13 값(기획정책이사)을 그대로 냈다 — 다시 넣지 말 것. */
const { doctor } = landing;

/* §E 확정 지표. 라벨은 줄 배열(2차 §4: 첫 라벨 2줄) — 데이터에서는 label 의 줄바꿈(\n)이
   그 줄을 나눈다.
   ⚠️ 2026-08-23 이전에는 이 배열이 하드코딩이었고, 옛 운영앱 백반증 지표 화면(2026-09-03 제거)의 '지표' 입력칸은
      소비처가 0이었다 — 원장이 운영앱에서 고쳐도 화면은 그대로였고 두 값이 갈라져 있었다
      (운영앱 102편 / 화면 205편). 지금은 landing.stats 가 정본이다.
   ⚠️ 논문 수 205 (원장 확정 2026-08-02 "전체 논문수 205편으로 바꾸고").
   같이 바뀐 것: 205는 **백반증 논문만이 아니라 전체 발표 실적**이라, 라벨에서 '백반증 관련'을
   뺐다 — 안 빼면 사실과 다른 진술이 된다. 백반증 연구는 '그중 핵심 연구를 소개'로 문장이 감당.
   ⚠️ 이 숫자를 운영앱에서 바꿔도 **따라오지 않는 곳**이 있다(함께 고쳐야 한다):
      /images/vitiligo/about/research-205-plus.svg — 숫자가 그림으로 그려져 있어 교체가 필요하다 ·
      이 파일 연구 섹션 문구 2곳 · VitiligoAboutPanel.astro(문구 2곳·숫자 블록) ·
      VitiligoResearchPanel.astro(RESEARCH_TOTAL) */
const STATS = landing.stats.map((s) => ({
  num: s.num,
  unit: s.unit,
  /* ?? '' — 게이트가 켜지기 전까지 이 JSON 은 exporter 검증을 거치지 않는다(손으로 고치는
     구간이다). label 이 빠져도 빌드가 죽지 않게 한다. */
  label: (s.label ?? '').split('\n'),
}));

/* §F Specialty 3블록 (4차: 슬라이더 → 세로 나열, 확정 카피·지정 줄바꿈·굵게).
   paras: 문단 배열(빈 줄 = 문단 경계), lines: 데스크톱 강제 줄바꿈(모바일 자연 흐름).
   alt: 블록 사진(specialty-step-0n.webp)의 대체 텍스트.
   ⚠️ img·pos(구 '차별점' 카드 사진 /images/vitiligo/card-*.jpg 등) 필드는 2026-08-03 PC/모바일
      통합에서 제거했다 — 모바일 전용 블록이 사라지며 소비처가 0이 됐고(사진은 specialty-step
      3장으로 단일화), 필드를 남겨 두면 '카드마다 사진이 두 벌'로 읽혀 관리 지점이 갈린다.
      원본 파일은 public/ 에 그대로 있으니 되돌릴 땐 git 이력에서 필드만 복원하면 된다. */
const CARDS = [
  {
    title: '정확한 진단이 우선입니다.',
    alt: '진료실에서 백반증 자료를 함께 보며 상담하는 배정민 원장',
    paras: [
      {
        lines: [
          '"백반증을 좀 더 정확히 진단할 수 없을까?"',
          "세상에 없던 '백반증 특수촬영 카메라'는 배정민 원장의 이 깊은 고민에서 시작되었습니다.",
          '특수촬영으로 육안으로는 잘 보이지 않는 미세한 병변까지 찾아냅니다.',
          '매번 같은 각도와 조명으로 상태를 객관적으로 기록하고,',
          '축적된 데이터에 비추어 앞으로의 치료 반응을 미리 가늠합니다.',
        ],
      },
      {
        bold: true,
        lines: [
          '이렇게까지 진단에 공을 들이는 이유는 단 하나',
          '유형이 다르면 치료 계획도 완전히 달라져야 하기 때문입니다.',
        ],
      },
    ],
  },
  {
    title: '환자에 맞는 치료를 설계합니다.',
