/* 통계 사진 — 기존 폴더 스캔 그대로(장수 유동, 파일 목록 하드코딩 금지) */
const listJpg = (segments: string[], prefix = ''): string[] => {
  try {
    return readdirSync(path.resolve(process.cwd(), ...segments))
      .filter((f) => f.startsWith(prefix) && f.endsWith('.jpg'))
      .sort();
  } catch {
    return [];
  }
};
const statsImages = listJpg(['public', 'images', 'vitiligo'], 'stats-').map(
  (f) => `/images/vitiligo/${f}`,
);
const specialistImages = [1, 2, 3, 4].map(
  (index) => `/images/vitiligo/landing/vitiligo-specialist-${String(index).padStart(2, '0')}.webp`,
);

/* 수치 밴드 배경 crossfade 키프레임 — 기존 LandingPanel 문법 그대로 이식 */
const XF_HOLD = 5;
const XF_FADE = 1;
const xfCycle = statsImages.length * XF_HOLD;
const pct = (v: number) => Math.round(v * 100) / 100;
const statsXfCss =
  statsImages.length > 1
    ? [
        `.hh-vstat-xf{opacity:0;animation:${xfCycle}s ease-in-out infinite;}`,
        ...statsImages.slice(1).map((_, idx) => {
          const i = idx + 1;
          const start = pct((i * 100) / statsImages.length);
          const fade = pct((XF_FADE / xfCycle) * 100);
          return (
            `.hh-vstat-xf-${i}{animation-name:hh-vstat-xf-${i};}` +
            `@keyframes hh-vstat-xf-${i}{0%,${start}%{opacity:0;}${pct(start + fade)}%,${pct(100 - fade)}%{opacity:1;}100%{opacity:0;}}`
          );
        }),
        `@media (prefers-reduced-motion: reduce){.hh-vstat-xf{animation:none;}}`,
      ].join('')
    : '';

/* 후기와 연구는 백반증 소스만 사용한다. 홈 데이터는 이 페이지에 반입하지 않는다. */

/* ⑤(PC) 후기 — ReviewSlider(variant="vitiligo") 아이템 매핑. 소스 = 위 REVIEWS 그대로 */
const vtReviewItems = REVIEWS.map((r, i) => ({
  text: r.title,
  body: r.body,
  author: `${r.name} (${r.region})`,
  meta: '백반증 치료 고객',
  image: `/images/vitiligo/reviews/review_profile_img${String(i + 1).padStart(2, '0')}.webp`,
}));

/* ⑦ 연구 목록 — 최신 5건 노출 + '연구 소개 더 보기' 링크.
   PC 는 참고 시안(백반증-pc.png) 기준 5건이었고, 모바일도 5건으로 통일됐다
   (원장 지시 2026-08-07 "모바일은 최신 연구 5개만 · 아래로 펼치는 더보기 없앨 것"). */
const researchTop = researchPapers.slice(0, 5);

const crumbs: Crumb[] = [
  { name: '홈', path: '/' },
  { name: '백반증', path: localeUrl(lang, 'vitiligo/') },
];

/* 감수자 — 백반증 일반 페이지의 구조화 데이터와 같은 사람·같은 날짜(lib/vitiligoMeta 단일 원천).
   ④-5 원장 블록(이름·학회 이력·프로필 링크)도 같은 사람이라 이 객체 하나를 쓴다 — 없으면 빌드를
   멈춘다(연구 상세 [slug].astro 의 '저자 배정민 없음' 과 같은 규약: 이력 블록이 조용히 비면 안 된다). */
const reviewer = await getDoctorIdentityBySlug(VITILIGO_REVIEWER_SLUG);
if (!reviewer) throw new Error(`[vitiligo] 감수·전문 의료진 없음: doctors.json 에 slug=${VITILIGO_REVIEWER_SLUG} 행이 없다`);
---

<Base headerOverlay>
  <SEOHead
    slot="seo"
    title={`백반증 | ${SITE.BRAND}`}
    description="백반증 외길 15년 — 특수촬영 진단부터 엑시머 레이저·광선치료·색소세포 이식 수술까지. 백반증을 연구해 온 전문의가 유형과 단계에 맞춰 치료를 설계합니다."
    jsonLd={[
      breadcrumbLd(crumbs),
      vitiligoPageLd({
        name: '백반증 클리닉',
        description:
          '백반증 외길 15년 — 진단부터 엑시머 레이저·광선치료·색소세포 이식 수술까지. 백반증을 연구해 온 전문의가 유형과 단계에 맞춰 치료를 설계합니다.',
        path: localeUrl(lang, 'vitiligo/'),
        reviewer,
        reviewedAt: VITILIGO_REVIEWED_AT,
      }),
    ]}
  />

  {/* ── .vt-scope — 백반증 공통 규격 토큰(src/styles/vitiligo.css)의 상속 루트.
      이 페이지 본문 전부를 한 겹으로 감싼다(문서당 딱 한 번 — 안쪽 섹션에 다시 붙이지 말 것).
      ⚠️ 스타일 없는 순수 래퍼다. transform·filter·overflow 를 걸면 안쪽의 position:fixed
         (④-5 배경 .vt45-bg · 고정 카테고리 바)가 통째로 죽는다(이 저장소의 재발성 함정). ── */}
  <div class="vt-scope">

  {/* 어두운 구간 전체(히어로+검정 밴드) — Header 오버레이 임계 기준(#vitiligo-hero) */}
  <div id="vitiligo-hero">
    {/* ── ① Hero — 사진 5장 캐러셀(메인 페이지 형식, 원장 지시 2026-08-02).
        문구는 컴포넌트 안 SLIDES 한 곳에서만 고친다.

        headingTag="p" — 히어로 카피는 5장이 3초마다 돌아가므로 그중 한 장이 이 페이지의
        대표 제목일 수 없다. 대신 아래 h1 이 페이지 주제를 진다(SEO/AEO 검토 2026-08-02 ①,
        서브 7개와 같은 처방). 화면은 종전 그대로 — 태그만 바뀐다. ── */}
    <h1 class="sr-only">백반증 클리닉 — 진단부터 광선치료·색소세포 이식 수술까지</h1>
    <VitiligoHero headingTag="p" />

    {/* ── 검정 밴드(②·③) — 애니메이션 모드에선 히어로를 덮으며 상승(커튼).
        커튼 선두의 vt-navgap(바 높이)은 고정 카테고리 바가 정확히 덮는 자리 —
        바가 섹션2 상단에 붙어 함께 상승하는 연출(원장 지시 2026-07-23 ②-1-1).
        data-ctabar-reveal(원장 지시 2026-07-28 4-M-1) — 모바일 하단 푸시 바는 히어로에선
        숨고, 이 커튼(섹션2)이 화면에 꽉 차게 올라올 때 등장(MobileCtaBar 공용 마커) ── */}
    <div class="vt-cover relative z-10" data-ctabar-reveal>
      <div class="vt-navgap" aria-hidden="true"></div>
      <div class="vt-dark" data-vt-dark>
      {/* ② Agitation — 가운데 세로 이미지 + 대각선 카피(카피는 이미지 세로 범위 안) */}
