/* §H 후기 22건 — healhouseskin.com "백반증센터 고객 리뷰" 이식(2026-07-22 추출, 원문 그대로) */
interface Review {
  name: string;
  region: string;
  title: string;
  body: string;
}
const REVIEWS: Review[] = [
  { name: 'Soph***', region: '수원시 팔달구', title: '대학병원 출신 백반증 전문 선생님 계시고 친절하고 전문적입니다.', body: '레이저 치료 중인데 여기서 많이 좋아져서 같은 치료기라도 어떻게 다루는가에 따라 경과가 다르구나 하고 생각하고 있습니다. 선생님 믿고 꾸준히 주 2회 치료 중인데 백반증도 수술로 개선이 가능하다고 하네요. 저는 아직 레이저 단계입니다만 수술까지 안 가고 나아보려고요. 파이팅! 잘 부탁드립니다.' },
  { name: 'Hkh0***', region: '평택시', title: '명성대로 친절하시고 꼼꼼하세요.', body: '제 이야기 다 들어주시고 초진은 30분 정도 봐주시더라고요. 사진도 많이 찍고 엑시머, 광선치료, 주사치료까지 시간이 많이 걸렸지만 꼼꼼해서 더 좋았어요. 백반증 미백관리도 받고 있는데 만족합니다.' },
