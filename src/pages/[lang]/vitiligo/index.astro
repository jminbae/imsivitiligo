        <div
          class="vt45-bleed relative mt-[60px] flex aspect-[7/2] w-full snap-x snap-mandatory overflow-x-auto bg-[#0d0e10]"
          data-doctor-carousel
          role="region"
          aria-roledescription="carousel"
          aria-label={`${reviewer.name} 원장님 백반증 연구 활동 사진`}
        >
          {specialistImages.map((src, index) => (
            <img
              src={src}
              alt={[
                '백반증 관련 연구 논문 모음',
                '백반증 학술대회에서 발표하는 배정민 원장님',
                '백반증 학술 강의를 듣는 배정민 원장님',
                '국제 백반증 심포지엄에서 발표하는 배정민 원장님',
              ][index]}
              width="1400"
              height="400"
              loading="lazy"
              decoding="async"
              data-doctor-slide
              class="vt-step-fade h-full w-full shrink-0 snap-start object-cover motion-reduce:transition-none"
            />
          ))}
          {/* 좌우 넘김 — 원형 배경 폐기(원장 지시 2026-08-07 "동그라미 빼고 화살표만").
              접근성은 배경이 아니라 아래 셋이 지탱한다:
              ① 접근명 = aria-label(글리프는 aria-hidden 장식) — 배경과 무관하게 그대로,
              ② 포커스 표시 = focus-visible 흰 아웃라인 유지(원형이 사라져도 사각 링으로 보인다),
              ③ 터치 타깃 = h-10 w-10(40px) → h-11 w-11(44px). WCAG 2.5.8 최소치를 배경 없이도
                 확보한다(배경이 있을 땐 40px 원이 시각적 힌트를 겸했지만 이제 없다).
              추가로 흰 화살표가 밝은 사진 위에서 사라지지 않도록 글리프에 drop-shadow 를 준다
              (배경 오버레이가 하던 대비 확보를 글리프 자체로 옮긴 것).
              글리프는 이 파일 ⑤(PC) 후기 화살표와 같은 규격(24×24·stroke 1.5·-scale-x-100 반전) 재사용.
              바깥 inset(3/5)은 종전 그대로 — 버튼 40→44, 글리프 16→24 라 안쪽 패딩이 12→10px 로
              줄어, 화면상 화살표 위치는 종전 대비 2px 안쪽이다(사실상 동일). */}
          <div data-doctor-controls hidden class="absolute inset-x-3 top-1/2 flex -translate-y-1/2 justify-between md:inset-x-5">
            <button type="button" data-doctor-prev aria-label="이전 사진" class="vt-tint-fade flex h-11 w-11 items-center justify-center text-white hover:opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="drop-shadow-[0_1px_3px_rgb(0_0_0_/_0.55)]"><path d="M12 22.304L1.69604 12L12 1.69602" stroke="currentColor" stroke-width="1.5" /></svg>
            </button>
            <button type="button" data-doctor-next aria-label="다음 사진" class="vt-tint-fade flex h-11 w-11 items-center justify-center text-white hover:opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="-scale-x-100 drop-shadow-[0_1px_3px_rgb(0_0_0_/_0.55)]"><path d="M12 22.304L1.69604 12L12 1.69602" stroke="currentColor" stroke-width="1.5" /></svg>
            </button>
          </div>
          <div data-doctor-controls hidden class="absolute inset-x-0 bottom-3 flex justify-center gap-2" aria-hidden="true">
            {specialistImages.map((_, index) => (
              <span data-doctor-dot class:list={['vt-tint-all h-1.5 rounded-full bg-white/55', index === 0 ? 'w-6 bg-white' : 'w-1.5']} />
            ))}
          </div>
          <p class="sr-only" aria-live="polite" aria-atomic="true" data-doctor-status></p>
        </div>
      </div>
    </section>

    {/* ── ⑤ 후기 — 전 뷰포트 **단일 블록**(검수 2026-08-11 — 크롤러 이중 렌더 제거, 원장 확정).
        종전에는 PC 블록(hidden md:block, ReviewSlider)과 모바일 블록(md:hidden, 전용 .vt-slider
        마크업 + [data-vt5] 스크립트)이 같은 REVIEWS 22건을 정적 HTML 에 두 번 실었다.
        → ReviewSlider(반응형 내장 — 모바일 240×280 카드·본문 line-clamp) **한 벌**이 전 폭을
        담당하고, 모바일 전용 커스텀 슬라이더(마크업·스크립트·.vt-slider CSS)는 삭제했다.
        PC 는 종전 픽셀 그대로. 모바일은 카드가 커스텀 흰 카드 → ReviewSlider 카드로 바뀐다
        (원장 실물 확인 대상 — 상세는 아래 각 지점 주석).
        섹션 이름 vt5p(-p = 구 PC 블록 유래)·배경 .vt5p 는 CSS·계약 테스트 앵커라 그대로 둔다.
        배경 = 참고 시안 실측 그라데이션(흰 → #CCE4F3 계열) — 이제 모바일에도 깔린다. ── */}
    <section aria-labelledby="vt5p-title" class="vt5p relative overflow-hidden pb-48 pt-28 md:pb-[120px] md:pt-[140px]">
      <div class="wrapper md:text-center">
        {/* 아이브로우 — 뷰포트별 **다른 카피**라 이중 렌더가 아니다(지시: 모바일 전용 카피는
            반응형으로 유지). 모바일 = 종전 모바일 블록의 'Real Review · ★★★★★ 5.0',
            md+ = 홈 공통 아이브로우 규격의 'REVIEW'(원장 지시 2026-08-01 "모두 대문자"). */}
        <p class="label-caps text-sky-deep md:hidden">Real Review · <span aria-hidden="true">★★★★★</span> 5.0</p>
        <p class="hidden text-[20px] font-semibold leading-[28px] text-brand md:block">REVIEW</p>
        <div class="relative mt-3">
          {/* 제목 — 한 벌. 모바일 = 종전 sec-title·vt-mtitle 그대로, md+ 는 종전 PC 블록의
              36px/54px·자간 normal 을 유틸리티로 복원(sec-title 의 -0.02em 을 덮는다).
              id 는 구 모바일 블록의 vt5-title 이 아니라 vt5p-title 을 계승(계약 테스트 앵커). */}
          <h2 id="vt5p-title" class="sec-title vt-mtitle break-keep md:text-[36px] md:leading-[54px] md:tracking-normal">
            피부보다 사람을 먼저 봅니다
          </h2>
          {/* PC 화살표 — 메인 ⑤와 완전 동일 스펙(24×24 스트로크·#BABDC0→잉크·44px·gap 10px).
              Swiper 연결은 ReviewSlider [data-rs-prev/next] 셀렉터 그대로 */}
          <div class="absolute inset-y-0 right-0 hidden items-center gap-2.5 md:flex">
            <button
              type="button"
              data-rs-prev
              aria-label="이전 후기"
              class="flex h-11 w-11 items-center justify-center text-[#BABDC0] transition-colors hover:text-ink"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 22.304L1.69604 12L12 1.69602" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </button>
            <button
              type="button"
              data-rs-next
              aria-label="다음 후기"
              class="flex h-11 w-11 items-center justify-center text-[#BABDC0] transition-colors hover:text-ink"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="-scale-x-100">
                <path d="M12 22.304L1.69604 12L12 1.69602" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </button>
          </div>
        </div>
        {/* 서브 카피 — 문구는 한 벌(검수 2026-08-11 — 크롤러 이중 렌더 제거). 모바일 = 종전
            sec-sub 자연 흐름 그대로(줄바꿈 강제 없음), md+ = 참고 시안 기준 3줄 분리(<br> 은
            md+ 에서만 산다 — 소스 줄바꿈이 모바일에서 공백으로 붙어 종전 문단과 동일). */}
        <p class="sec-sub mt-4 break-keep md:mx-auto md:mt-5 md:max-w-4xl md:text-[16px] md:leading-[28px]">
          하얀 반점을 줄이는 것만이 치료의 전부는 아닙니다.<br class="max-md:hidden" />
          치료 전에 충분히 설명하고, 반복적인 물리적 자극처럼 피해야 할 생활 요인까지 함께 안내합니다.<br class="max-md:hidden" />
          오래 걸리는 치료일수록, 과정을 아는 환자가 흔들리지 않습니다.
        </p>
        {/* 개인차·면책 — 후기 카드보다 **먼저** 읽히게 구획 상단에 둔다(공용 컴포넌트).
            후기 구획이 한 벌이 되며 이 한 줄도 페이지에 한 번만 나간다. */}
        <ReviewDisclaimer factors="백반증의 유형·활동성·부위" class="mt-4 md:mx-auto md:max-w-4xl" />
      </div>
      {/* 슬라이더 — ReviewSlider 가 반응형을 내장한다: PC = 430px 카드·전문 표시(min-h 250 가변),
          모바일 = 240×280 고정 카드·본문 line-clamp·카드 아래 우측 화살표(md:hidden).
          PC 화살표(위 제목 줄 우측)와 모바일 화살표는 Swiper 가 셀렉터 문자열로 둘 다 바인딩. */}
      <div class="mt-4">
        <ReviewSlider items={vtReviewItems} variant="vitiligo" />
      </div>
    </section>

    {/* ── ⑦ 연구 소개 — PC·모바일 단일 반응형 DOM(원장 지시 2026-08-07) ──
        [종전] PC = 이 블록(hidden md:block, 5건 + 전체 보기), 모바일 = 별도 md:hidden 블록
               (가운데 정렬 헤더 + FeedList 10건·+10 더보기 + 전체 보기) 두 벌이었다.
        [지시] "모바일은 최신 연구 5개만 · 아래로 펼치는 더보기 없앨 것 · 대신 '연구 소개 더 보기 >'
               로 /vitiligo/research/ 이동 · PC 도 같은 문구로 통일 · 디자인은 '백반증이란'
               페이지의 연구 소개 것". 모바일에서 개수·더보기·문구·디자인이 전부 PC 와 같아졌으므로
               두 벌을 유지할 근거가 사라졌다 → 옛 모바일 FeedList 블록은 삭제하고 이 블록 하나가
               두 폭을 모두 담당한다(④·④-5 가 이미 같은 방식으로 통합돼 있다).
        ⚠️ 디자인 출처는 '백반증이란' 의 연구 소개 섹션(옛 `.vta-s8`)이었고, SVG 한 장 + 목록
           디자인 + 모바일 1단 적층까지 그쪽 값을 그대로 옮겨왔다(대조표는 .vt7p-* 스타일 주석).
           **그 원본은 2026-08-07 원장 지시로 삭제됐다** — 이제 쌍둥이가 아니라 이 블록이 유일한
           정본이다. 값을 고칠 때 맞춰야 할 상대가 없으니 여기서 자유롭게 결정하면 된다.
           (단 항목 링크 호버는 원본의 볼드+밑줄이 아니라 하이라이트다 — 원장 지시 2026-08-07.)
        모바일도 사이트 공용 .wrapper 로 내용의 좌우 선을 유지한다. ── */}
    {
      researchPapers.length > 0 && (
        <section aria-labelledby="vt7p-title" class="vt7p">
          <div class="wrapper pb-28 pt-24 md:pb-[120px] md:pt-[140px]">
            {/* 모바일 1단 · md+ 2단. 1단일 때 두 칸 사이 90px 은 '백반증이란' 쪽
                `.vta-research-column { margin-top: 90px }` 값 그대로. */}
            <div class="vt7p-grid grid gap-y-[90px] md:grid-cols-2 md:gap-x-[clamp(3rem,6vw,6rem)] md:gap-y-0">
              <div class="flex flex-col">
                <div>
                  {/* 영문 라벨 — 홈 공통 아이브로우 규격(원장 지시 2026-08-01 "모두 대문자"). 타이포는 종전 동일. */}
                  <p class="text-[20px] font-semibold leading-[28px] text-brand">HEALHOUSE VITILIGO</p>
                  {/* 26 → 36px 는 이 파일 ⑧ 제목과 같은 반응형 규격(모바일에서 36px 은 3줄로 무너진다) */}
                  <h2 id="vt7p-title" class="mt-3 break-keep text-[26px] font-semibold leading-[1.4] text-ink md:text-[36px]">
                    힐하우스 백반증 연구 소개
                  </h2>
                  {/* 제목↔내용 40px(모바일 24px) */}
                  <p class="vt-left-copy mt-6 break-keep text-[16px] leading-[28px] text-charcoal md:mt-10">
                    환자 한 명 한 명을 더 정확히 보기 위해 끊임없이 연구합니다.<br />
                    전 세계가 인정하는 배정민 원장의 205편+ 연구 기록 중 핵심 연구를 소개합니다.
                  </p>
                </div>
                {/* 좌하단 마크 — 종전 두 장(vitiligo-research.svg + 205plus.svg)을 한 장으로 통합
                    (원장 지시 2026-08-07 "기존에 두 개로 나뉘어 있었다면 이 한 파일로 통합").
                    ⚠️ 전달본은 숫자가 `102+` 였는데, 원장이 이어서 "연구 논문 수는 205편+로 하자.
                       그 중에 주요 연구를 소개하는 것으로" 라고 확정했다(102 = 백반증 논문,
                       205 = 전체 발표 실적). 그래서 전달본 워드마크는 그대로 쓰고 숫자 그룹만
                       기존 205plus.svg 로 교체한 합성본(research-205-plus.svg)을 쓴다.
                       전달본에서 숫자가 놓였던 자리(x=0, y=141)를 그대로 쓰며, 102plus(227px)와
                       205plus(257px)는 높이가 88px 로 같아 세로 정렬이 어긋나지 않는다.
                       205+ 통합 원본을 받으면 이 합성본을 그것으로 교체하면 된다.
                    block — 인라인 라인박스 하단 여백(≈3px) 제거: 마크 하단 = 목록 하단 정확 일치.
                    ⚠️ '백반증이란' 쪽 `.vta-research-mark` 의 mix-blend-mode: screen 은 **가져오지 않았다**.
                    마크 색이 #8EB8D5(밝은 하늘)라 screen 은 배경이 밝을수록 흰색으로 날아간다 —
                    저쪽 배경(about/research-bg.webp, 실측 평균 195,218,231)과 달리 이 섹션 배경
                    (landing/research-bg.webp, 실측 평균 248,251,253)은 거의 흰색이라 마크가 사라진다.
                    종전 이 자리 두 장도 blend 없이 그대로 얹던 방식이라 그 처리를 유지한다. */}
                <img
                  src="/images/vitiligo/about/research-205-plus.svg"
                  alt="Vitiligo Research 205+"
                  width="585"
                  height="233"
                  loading="lazy"
                  decoding="async"
                  class="mt-auto block h-auto w-[585px] max-w-full pt-16"
                />
              </div>
              {/* 우(모바일에서는 아래) — 연구 목록. 디자인 정본 = VitiligoAboutPanel `.vta-research-*`
                  (원장 지시 2026-08-07 "'백반증이란' 섹션 디자인 그대로"). 최신 5건(researchTop)은
                  PC·모바일 공통 — 모바일도 5개로 맞추라는 지시(그쪽 '백반증이란'은 6건).
                  ⚠️ 항목 텍스트에 data-label 을 달지 않는다 — 그 속성은 호버 볼드용 고스트
                     (`::after { content: attr(data-label) }`) 전용이었고, 호버가 하이라이트로
                     바뀌며 고스트를 폐기했다(아래 .vt7p-research-list 주석). */}
              <div>
                <ol class="vt7p-research-list">
                  {researchTop.map((p) => (
                    <li>
                      <span class="vt7p-research-dot" aria-hidden="true" />
                      <div>
                        {/* 제목은 태그와 같은 줄에 — 줄바꿈으로 앞뒤 공백이 들어가면
                            inline 배경 하이라이트가 그 공백까지 칠한다. */}
                        <a href={localeUrl(lang, `vitiligo/research/${p.slug}/`)} data-research-list-intent={p.slug}>{p.subtitle_en || p.subtitle_ko}</a>
                        <p>
                          {p.journal}
                          {p.year ? ` (${p.year})` : ''}
                        </p>
                      </div>
                    </li>
                  ))}
                </ol>
                {/* 문구 '연구 소개 더 보기 >'(원장 지시 2026-08-07) — PC·모바일 통일.
                    종전 PC '연구 소개 전체 보기', 모바일은 같은 문구에 → 글리프였다. */}
                <a href={localeUrl(lang, 'vitiligo/research/')} class="vt7p-research-all">
                  연구 소개 더 보기
                  <svg width="8" height="12" viewBox="0 0 8 12" fill="none" aria-hidden="true">
                    <path d="m1 1 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </section>
      )
    }
  </div>

  </div>{/* /.vt-scope */}
</Base>

<style>
  /* 검정 밴드 — §A 배경 체계. 커튼(-100svh)은 히어로 시퀀스 스크립트가 html.vhseq-on을
     켤 때만(모션 허용 시 전 뷰포트 — 2026-07-23 B-1 모바일 확대) — reduced-motion·no-JS는 일반 흐름 */
  .vt-dark {
    background: #0d0e10;
  }

  /* 치료 철학: 좌측 정렬 본문은 PC 전 구간에서 640px을 확보한다. 좁은 PC에서 기존
     대각 배치 안에 억지로 겹치지 않도록 사진 아래로 내리고, 넓은 화면에서만 우하단 배치를
     유지한다. 1920px에서는 바깥 fluid 여백을 사용해 사진과 본문 사이에 간격이 남는다. */
  @media (min-width: 768px) {
    .vt-philosophy-copy {
      width: min(640px, 100%);
      max-width: none;
    }
  }
  @media (min-width: 768px) and (max-width: 1919.98px) {
    .vt-philosophy-shell {
      padding-bottom: 88px;
    }
    .vt-philosophy-copy {
      position: relative;
      right: auto;
      bottom: auto;
      margin-top: 40px;
      margin-left: auto;
    }
  }
  @media (min-width: 1920px) {
    .vt-philosophy-stage {
      max-width: none;
    }
    .vt-philosophy-title {
      left: max(0px, calc((100% - 1152px) / 2));
      max-width: 518.4px;
    }
  }
  /* 커튼 선두 바 자리 — 고정 카테고리 바(VitiligoStickyNav)가 이 위를 정확히 덮는다.
     바와 같은 var를 봐서 높이 어긋남 없음(2026-07-23 ②) */
  .vt-navgap {
    height: var(--vt-catnav-h);
    background: #0d0e10;
  }
  /* ── PC 개편 새 섹션(원장 지시 2026-07-30 8차) ─────────────────────────
     ④ Specialty 3장 — 등장 연출은 페이지 공용 [data-vt-reveal](IO 스크립트가 is-in 부여)을
     그대로 쓴다. 다만 공용 초기 숨김 CSS 는 모바일(≤767) 한정이라, 이 섹션만 전 폭에서
     걸리도록 클래스로 한 번 더 선언한다.
     ⚠️ 공용 규칙의 미디어쿼리를 PC까지 넓히면 안 된다 — 페이지 전체 [data-vt-reveal]
        (섹션 ②·⑤ 등)의 PC 동작(항상 표시)이 통째로 바뀐다. 그래서 스코프를 좁혔다.
     ⚠️ 선택자를 .vt4s-item[data-vt-reveal] 로 둔 것도 의도 — 모바일에서 공용 규칙과
        특이도가 같으면 소스 순서에 값이 좌우된다(0,3,1 vs 0,2,1 로 항상 이 규칙이 이긴다).
     핀 시퀀스(vt4p-*) CSS 는 2026-08-03 통합에서 마크업과 함께 제거했다. */

  /* ④ 컨테이너 — 마크업에서 .wrapper-fluid 와 함께 쓴다. ≤767 은 .wrapper-fluid 인셋을
     그대로 두고(모바일 형제와 동일), md+ 에서만 .wrapper 기하로 갈아탄다.
     ⚠️ 아래 세 값은 global.css `.wrapper` 의 md+ 정의를 그대로 옮긴 것이다 — 그쪽이 바뀌면
        여기도 함께 고쳐야 한다(컴포넌트 클래스는 미디어쿼리로 갈아끼울 수 없어 불가피한 중복).
     ※ Astro 스코프 스타일은 레이어 밖이라 @layer components 의 .wrapper-fluid 를 이긴다. */
  @media (min-width: 768px) {
    .vt4s-wrap {
      margin-inline: auto;
      max-width: var(--site-shell);
      padding-inline: var(--site-gutter);
    }
  }

  :global(html.vt-reveal-on) .vt4s-item[data-vt-reveal] {
    opacity: 0;
    transform: translateY(24px);
    /* 0.8s — 전역 원칙 '스르륵, 서서히'. 블록이 크므로 공용 등장(--editorial-reveal-duration
       700ms)보다 한 박자 길게. 「같게 맞추지 말 것」이 이 주석의 뜻이므로 2026-09-04 값
       일관성 작업에서도 토큰으로 합치지 않고 리터럴을 남긴다(공용 값 표기만 갱신). */
    transition:
      opacity 0.8s var(--ease-editorial),
      transform 0.8s var(--ease-editorial);
  }
  :global(html.vt-reveal-on) .vt4s-item[data-vt-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  /* ④-5 — 배경 고정 효과: background-attachment:fixed 대신 clip-path 컨테이너 +
     position:fixed 레이어(합성 친화, 본문 스크롤 시 배경이 제자리 — 지시 권장안) */
  .vt45 {
    clip-path: inset(0 0 0 0);
    background: #0d0e10; /* 이미지 로드 전 폴백 */
  }
  .vt45-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #0d0e10 url('/images/vitiligo/landing/doctor-band-bg.webp') center / cover no-repeat;
  }
  .vt45-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.55); /* 텍스트 대비 확보 오버레이(시안 톤) */
  }
  /* ④-5 연구 활동 사진 — 모바일만 화면 전폭(원장 지시 2026-08-07 "좌우 여백 없이 꽉 차게").
     공식은 global.css `.bleed`(margin-inline: calc(50% - 50vw)) 그대로다 — 그 클래스는 반응형
     게이트가 없어 md+ 까지 같이 터지므로, 같은 선언을 이 브레이크포인트에만 건다.
     스크롤바 폭 초과분은 base 레이어의 body overflow-x clip 이 흡수(global.css 주석 참조). */
  @media (max-width: 767px) {
    .vt45-bleed {
      margin-inline: calc(50% - 50vw);
    }
  }

  /* ⑤(PC) 후기 — 참고 시안 실측 그라데이션(상단 흰 → 카드 구간 #CCE4F3 계열) */
  .vt5p {
    background: linear-gradient(180deg, #ffffff 0%, #f7fafc 28%, #cce4f3 76%, #d6eaf6 100%);
  }

  /* ⑦(PC) 연구 소개 — 전달 배경(research-bg: 좌하단 블루 글로우) */
  .vt7p {
    background-image: url('/images/vitiligo/landing/research-bg.webp');
    background-size: cover;
    background-position: center bottom;
  }

  /* 연구 소개: 640px 좌측 본문을 우선한다. 두 열을 함께 담기 어려운 좁은 PC에서는
     연구 목록을 다음 행으로 내려 어떤 PC 폭에서도 본문이 임의의 절반 폭으로 눌리지 않는다. */
  @media (min-width: 768px) and (max-width: 1199.98px) {
    .vt7p-grid {
      grid-template-columns: minmax(0, 640px);
      row-gap: 90px;
    }
  }
  @media (min-width: 1200px) {
    .vt7p-grid {
      grid-template-columns: minmax(0, 640px) minmax(0, 1fr);
    }
  }

  /* ── ⑦ 연구 목록 — 원장 지시 2026-08-07 "'백반증이란' 섹션 디자인 그대로".
     정본 = src/components/vitiligo/VitiligoAboutPanel.astro `.vta-research-list` /
     `.vta-research-dot` / `.vta-research-all`. 아래 선언은 그 블록을 값까지 그대로 옮긴 것이다
     (Astro scoped 라 클래스명을 공유할 수 없어 접두어만 vt7p- 로 바꿨다).
     종전 이 자리 디자인(밑줄 구분선 border-b + stretched-link + 저널 #A5A7AA 12/16)은 폐기.
     ⚠️ 딱 한 곳만 정본과 다르다 — 항목 링크 **호버 연출**(원장 지시 2026-08-07 2차:
        "볼드체와 밑줄 넣지 말고 하이라이트가 쳐지는 것으로"). 저쪽 정본은 아직 볼드+밑줄이다. ── */
  .vt7p-research-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .vt7p-research-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .vt7p-research-dot {
    width: 5px;
    height: 5px;
    margin-top: 9px;
    flex: 0 0 5px;
    border-radius: 50%;
    background: #6899C0;
  }
  /* 링크 본체 — 호버 하이라이트(형광펜) 연출.
     · display 를 정본의 inline-grid → inline 으로 되돌렸다. inline-grid 는 오직 '볼드 고스트'를
       같은 grid-area 에 겹쳐 폭을 예약하려던 장치였고(::after { content: attr(data-label) }),
       볼드가 사라진 지금은 소비처가 0이다. 게다가 inline-grid 는 박스가 하나라 여러 줄 제목에
       띠가 '가장 긴 줄 폭의 사각형' 하나로 깔린다 — inline 이라야 줄마다 형광펜이 그어진다.
     · 배경 띠 색 = rgb(104 153 192 / 0.3). #6899C0 은 이 섹션이 이미 쓰는 유일한 유채색
       (목록 불릿 .vt7p-research-dot · '연구 소개 더 보기' 링크 색)이라, 새 색을 들이지 않고
       그 accent 의 30% 틴트만 쓴다. 근처 배경(landing/research-bg.webp 실측 평균 248,251,253)
       위에서 ≈#C4D8E8 로 깔리고, 그 위 본문색 #292A2B 대비는 9:1 대로 AA(4.5:1) 여유.
     · 왼→오 차오름 = background-size 의 x 축만 0 → 100%. background-position: 0 0 은
       inline 요소의 배경 영역(폰트 박스 ≈1.15em)에 맞춰 글자 뒤에 정확히 깔린다.
     · box-decoration-break: clone — 제목이 두 줄로 접힐 때 줄마다 독립된 띠가 그어지게 한다
       (기본 slice 는 '끊기지 않은 한 박스' 기준이라 둘째 줄이 통째로 칠해지거나 빈다). */
  .vt7p-research-list a {
    display: inline;
    color: var(--color-ink);
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    background-image: linear-gradient(rgb(104 153 192 / 0.3), rgb(104 153 192 / 0.3));
    background-repeat: no-repeat;
    background-position: 0 0;
    background-size: 0% 100%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    /* 링크 hover 의 형광펜 차오름 — 색 계열 즉각 반응이라 --motion-tint(종전 320ms,
       원장 지시 2026-09-04 「값 일관성」). */
    transition: background-size var(--motion-tint) var(--ease-editorial);
  }
  .vt7p-research-list a:hover,
  .vt7p-research-list a:focus-visible {
    background-size: 100% 100%;
  }
  .vt7p-research-list li p {
    margin-top: 4px;
    color: #7C8288;
    font-size: 12px;
    line-height: 18px;
  }
  .vt7p-research-all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 32px;
    color: #6899C0;
    font-size: 16px;
    font-weight: 600;
    line-height: 20px;
  }
  .vt7p-research-all svg {
    flex: none;
    /* 손끝에 반응해 움직이는 화살표 = --motion-lift. 이 페이지에 250ms ease-out 과
       300ms(Tailwind 기본 곡선) 두 갈래가 있었는데 하나로 모았다(.vt-nudge 와 같은 값). */
    transition: transform var(--motion-lift) var(--ease-editorial);
  }
  .vt7p-research-all:hover svg,
  .vt7p-research-all:focus-visible svg {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .vt7p-research-all svg,
    /* 하이라이트는 '차오르는' 연출이라 모션 축소 시 전환만 끈다 — 띠 자체는 즉시 100%로 나타나
       호버 피드백이 사라지지 않는다. */
    .vt7p-research-list a {
      transition: none;
    }
  }

  /* ── 모션 사다리 표식(원장 지시 2026-09-04 「이런 값도 전체적으로 일관성이 있으면 좋겠어」) ──
     이 페이지의 Tailwind 유틸(transition-colors·transition-opacity·transition-all·
     transition-transform)은 --default-transition-duration 을 읽어 150~300ms 로 흩어져
     있었다. 전역 기본값을 덮으면 공개 사이트·운영앱·검수앱의 모든 전환이 함께 끌려가므로
     유틸을 걷어내고 자리마다 역할 토큰을 명시한다. */
  .vt-nudge {
    /* 손끝에 반응해 움직이는 화살표(종전 duration-300 + Tailwind 기본 곡선) */
    transition: transform var(--motion-lift) var(--ease-editorial);
  }
  .vt-step-fade {
    /* 사용자가 화살표를 눌러 한 칸 넘기는 사진 교차 = --motion-step(값 0.5s — 종전
       duration-500 과 같고, 곡선만 ease-in-out → --ease-editorial) */
    transition: opacity var(--motion-step) var(--ease-editorial);
  }
  .vt-tint-fade {
    /* 투명도만 바뀌는 화살표 버튼 hover(종전 Tailwind 기본 150ms) */
    transition: opacity var(--motion-tint) var(--ease-editorial);
  }
  /* ⑤ 후기 슬라이더 좌우 화살표(Tailwind 기본 150ms)는 일부러 그대로 두었다 —
     tests/home-review-section-shared-slider 가 홈 ⑤ 화살표와 「한 벌」임을 클래스 문자열로
     붙잡고 있어서, 이쪽만 토큰으로 옮기면 두 화면의 화살표가 갈라진다. 홈(⑤)과 함께
     한 번에 옮겨야 하는 자리다(2026-09-04). */
  .vt-tint-all {
    /* 인디케이터 점(폭 1.5→6 + 색). 색만 바뀌는 히어로 dot·figure dot 과 같은 박자로 모았다
       (종전 transition-all duration-300). */
    transition:
      width var(--motion-tint) var(--ease-editorial),
      background-color var(--motion-tint) var(--ease-editorial);
  }
  .hh-stat {
    /* ③ 수치 셀 hover/focus 배경(종전 Tailwind 기본 150ms) */
    transition: background-color var(--motion-tint) var(--ease-editorial);
  }
  @media (prefers-reduced-motion: reduce) {
    .vt-nudge,
    .vt-step-fade,
    .vt-tint-fade,
    .vt-tint-all,
    .hh-stat {
      transition: none;
    }
  }
  /* ⑤ 모바일 전용 슬라이더 CSS(.vt-slider 일대)는 삭제(검수 2026-08-11 — 크롤러 이중 렌더
     제거) — 후기가 공용 ReviewSlider 한 벌이 되며 소비처가 0이 됐다(no-JS 폴백도 그쪽 내장). */
  :global(html.vhseq-on) .vt-cover {
    margin-top: -100vh;
    margin-top: -100svh;
  }

  /* ── 모바일 타이포 위계(원장 지시 2026-07-23 B-3·B-4) ──────────────
     기준 = 섹션2 메인카피(clamp(1.5rem,1rem+2.8vw,3.25rem)·semibold).
     전 섹션 메인카피(vt-mtitle)를 이 기준으로 통일한다.
     ※ 굵기 700 → 600(원장 지시 2026-08-07 "이 페이지 bold 전부 semibold") —
       마크업 쪽 font-bold 를 전부 font-semibold 로 내렸으므로 이 규칙도 함께 내려야
       모바일에서만 다시 700 으로 덮이는 일이 없다.
     ※ 섹션4 블록 제목(.vt4-btitle)과 PC용 .sec-title.vt-mtitle-lg 오버라이드는 2026-08-03
       Specialty 통합에서 제거했다 — 두 규칙 모두 소비처가 옛 모바일 ④ 블록 하나뿐이었고,
       그 블록이 사라지며 매칭되는 요소가 0이 됐다(현 ④ 제목은 유틸리티로 직접 지정). */
  @media (max-width: 767px) {
    .vt-mtitle {
      font-size: clamp(1.5rem, 1rem + 2.8vw, 3.25rem);
      font-weight: 600;
      line-height: 1.45;
      letter-spacing: -0.02em;
    }
    /* vt-mtitle-lg — 섹션3 제목만 기준 clamp ×1.15 확대(원장 지시 2026-07-28 3-1).
       .vt-mtitle 공통 규칙은 그대로 두고 이 한 곳만 덮어씀 — 다른 섹션 제목 크기 불변 */
    .vt-mtitle-lg {
      font-size: clamp(1.725rem, 1.15rem + 3.22vw, 3.74rem);
    }
  }

  /* ── 모바일 스크롤 등장(원장 지시 2026-07-23 B-2·B-4) — 페이드인+살짝 위로.
     JS가 html.vt-reveal-on을 켠 경우에만 초기 숨김(no-JS 안전),
     reduced-motion은 JS에서 아예 켜지 않음 → 정적 표시. PC는 현재 상태 유지. ── */
  @media (max-width: 767px) {
    :global(html.vt-reveal-on) [data-vt-reveal] {
      opacity: 0;
      transform: translateY(18px);
      /* 스크롤 등장(reveal)의 정본은 --editorial-reveal-duration(700ms) — 종전 0.65s 는
         근거 없는 50ms 차이였다(원장 지시 2026-09-04 「값 일관성」). 거리 18px 은 모바일
         고유값이라 그대로 두고, 위 §4 블록의 0.8s 는 「한 박자 길게」가 주석에 명시돼 있어
         일부러 남겼다. */
      transition:
        opacity var(--editorial-reveal-duration) var(--ease-editorial),
        transform var(--editorial-reveal-duration) var(--ease-editorial);
    }
    :global(html.vt-reveal-on) [data-vt-reveal].is-in {
      opacity: 1;
      transform: none;
    }
  }
  .vt-guide {
    background: #eef5f8;
    color: var(--color-ink);
  }
  .vt-guide-inner {
    display: grid;
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
    gap: clamp(4rem, 9vw, 9rem);
    padding-block: 140px;
  }
  .vt-guide-head { align-self: start; position: sticky; top: calc(var(--header-h) + 5.5rem); }
  .vt-guide-kicker { color: #3f6f90; font-size: 20px; font-weight: 600; line-height: 28px; }
  .vt-guide-head .vt-added-title { color: #365f78; }
  .vt-guide-head h2 { margin-top: 14px; font-size: clamp(36px, 3.6vw, 52px); font-weight: 600; line-height: 1.3; letter-spacing: -.025em; }
  .vt-guide-head > p:not(.vt-guide-kicker, .vt-guide-note) { margin-top: 34px; max-width: 31rem; font-size: 17px; line-height: 2; }
  .vt-guide-note { margin-top: 22px; max-width: 31rem; color: #66727a; font-size: 14px; line-height: 1.8; }
  .vt-guide-list { border-top: 1px solid rgba(41, 42, 43, .28); }
  .vt-guide-list li { display: grid; grid-template-columns: 54px minmax(0, 1fr) auto; gap: 22px; align-items: start; padding-block: 30px; border-bottom: 1px solid rgba(41, 42, 43, .28); transition-delay: var(--vt-guide-delay, 0ms); }
  .vt-guide-no { padding-top: 4px; color: #3f6f90; font-size: 13px; font-weight: 700; letter-spacing: .08em; }
  .vt-guide-list h3 { font-size: 21px; font-weight: 600; line-height: 1.5; letter-spacing: -.015em; }
  .vt-guide-list p { margin-top: 9px; color: #59636a; font-size: 15px; line-height: 1.8; word-break: keep-all; }
  .vt-guide-list a { display: inline-flex; gap: 10px; align-items: center; margin-top: 4px; color: #365f78; font-size: 14px; font-weight: 600; white-space: nowrap; }
  .vt-guide-list a:hover span:first-child,
  .vt-guide-list a:focus-visible span:first-child { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 767px) {
    .vt-guide-inner { grid-template-columns: 1fr; gap: 52px; padding-block: 84px; }
    .vt-guide-head { position: static; }
    .vt-guide-kicker { font-size: 17px; line-height: 25px; }
    .vt-guide-head h2 { margin-top: 10px; font-size: 32px; line-height: 1.42; }
    .vt-guide-head > p:not(.vt-guide-kicker, .vt-guide-note) { margin-top: 24px; font-size: 16px; line-height: 1.85; }
    .vt-guide-list li { grid-template-columns: 38px minmax(0, 1fr); gap: 14px; padding-block: 25px; }
    .vt-guide-list h3 { font-size: 18px; }
    .vt-guide-list a { grid-column: 2; margin-top: 8px; }
  }
</style>

<script>
  import { initResearchListIntent } from '../../../lib/researchListIntentClient';

  initResearchListIntent();

  // ── ④ Specialty — 스크립트 없음(2026-08-03 통합).
  // 종전엔 여기서 섹션 핀 + 01→03 단계 스냅(initWheelSnap 별도 인스턴스 · scroll/resize 리스너 ·
  // stepPx/cur 상태)을 돌렸다. 원장 지시로 "밑으로 3장 이어지게"로 바뀌면서 전부 제거했다 —
  // 등장 연출은 이 파일 맨 아래 공용 [data-vt-reveal] IO 하나로 충분하다.
  // ⚠️ 이 페이지에서 initWheelSnap 을 쓰던 곳은 여기뿐이라 import 도 함께 지웠다.
  //    히어로(VitiligoHero)의 마지막 슬라이드 → 섹션1 착지는 캐러셀 자신을 기준으로
  //    계산하는 별개 로직(advanceToFirstSection)이라 이 삭제와 무관하다.

  // ── ③ 카운트업 (3차 §4 강화) — 셀 단위 IO(threshold 0.35)로 "밴드가 실제로 보일 때"
  // 시작 + rAF 스크롤 폴백(IO 미발화 환경 보험). 빠른 스크롤로 도착 전에 끝나 '미적용'처럼
  // 보이던 문제를 지속시간 1.5s + 가시 시점 트리거로 해소. reduced-motion은 최종값 즉시.
  {
    const cells = Array.from(document.querySelectorAll<HTMLElement>('[data-count-cell]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const run = (el: HTMLElement) => {
      const target = parseInt(el.dataset.countTo || '0', 10);
      if (reduce || !target) {
        el.textContent = String(target);
        return;
      }
      const myRun = String(Number(el.dataset.run || '0') + 1);
      el.dataset.run = myRun;
      const dur = 1500;
      let start = 0;
      const step = (now: number) => {
        if (el.dataset.run !== myRun) return;
        if (!start) start = now;
        const p = Math.min((now - start) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(target * eased));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const runCell = (cell: HTMLElement) => {
      if (cell.dataset.counted) return;
      cell.dataset.counted = 'true';
      cell.querySelectorAll<HTMLElement>('.hh-count').forEach(run);
    };
    cells.forEach((cell) =>
      cell.querySelectorAll<HTMLElement>('.hh-count').forEach((n) => (n.textContent = '0')),
    );
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              runCell(e.target as HTMLElement);
              obs.unobserve(e.target);
            }
          });
        },
        { threshold: 0.35 },
      );
      cells.forEach((c) => io.observe(c));
    }
    // 폴백 — IO가 못 잡는 환경/타이밍에도 화면 안에 들어오면 반드시 발동.
    // 전 셀 완료 시 리스너 자체 해제(enable/disable 정리 패턴과 일관 — 코드검수 반영)
    let raf = 0;
    const onFallbackScroll = () => {
      if (!raf) raf = requestAnimationFrame(check);
    };
    const check = () => {
      raf = 0;
      cells.forEach((c) => {
        if (c.dataset.counted) return;
        const r = c.getBoundingClientRect();
        if (r.top < window.innerHeight * 0.75 && r.bottom > 0) runCell(c);
      });
      if (cells.every((c) => c.dataset.counted))
        window.removeEventListener('scroll', onFallbackScroll);
    };
    window.addEventListener('scroll', onFallbackScroll, { passive: true });
    check();
    // 클릭/키보드 — ① 카운트업 재생(기존 유지) ② 해당 수치의 배경사진으로 부드럽게 전환
    // (원장 지시 2026-07-24 ② 2-B: 수치 i ↔ stats-0(i+1).jpg 매칭, reduced-motion은 즉시 전환)
    const bgWrap = document.querySelector<HTMLElement>('[data-vstat-bg]');
    const bgImgs = bgWrap
      ? Array.from(bgWrap.querySelectorAll<HTMLImageElement>('[data-vstat-img]'))
      : [];
    const selectBg = (idx: number) => {
      if (!bgWrap || bgImgs.length === 0) return;
      const target = idx % bgImgs.length;
      // 첫 선택 시 자동 크로스페이드(keyframes)를 내리고 수동 모드로 — opacity 트랜지션 전환.
      // 여기부터는 '사용자가 눌러 한 칸 넘기는' 것이라 --motion-step 이다(종전 0.7s ease,
      // 원장 지시 2026-09-04 「값 일관성」). 자동 순환의 XF_HOLD 5s·XF_FADE 1s 는 퍼센트가
      // 거기서 계산되는 값이라 그대로 두었다 — 자동과 수동은 역할이 다르다.
      if (!bgWrap.dataset.manual) {
        bgWrap.dataset.manual = 'true';
        bgImgs.forEach((img) => {
          img.style.animation = 'none';
          if (!reduce) img.style.transition = 'opacity var(--motion-step) var(--ease-editorial)';
        });
      }
      // 0번은 바닥(항상 opacity 1) — 위층(1~)만 조절해 대상 사진이 보이게
      bgImgs.forEach((img, i) => {
        if (i === 0) return;
        img.style.opacity = i === target ? '1' : '0';
      });
    };
    const activate = (cell: HTMLElement) => {
      cell.querySelectorAll<HTMLElement>('.hh-count').forEach((el) => {
        el.textContent = '0';
        run(el);
      });
      selectBg(parseInt(cell.dataset.statIndex || '0', 10));
    };
    cells.forEach((cell) => {
      cell.addEventListener('click', () => activate(cell));
      cell.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        activate(cell);
      });
    });
  }

  // ── ⑤ 후기 전용 슬라이더 스크립트는 삭제(검수 2026-08-11 — 크롤러 이중 렌더 제거).
  //    PC·모바일이 공용 ReviewSlider 한 블록으로 합쳐져 슬라이더 동작(Swiper·자동 전환·
  //    화살표·reduced-motion)은 그 컴포넌트 스크립트가 갖는다.
  // ── ④-5 연구 활동 사진 — 사용자가 순서대로 직접 넘기는 크로스페이드.
  // 자동 순환은 읽는 동안 움직임을 강제하고 별도 정지 제어가 필요하므로 사용하지 않는다.
  document.querySelectorAll<HTMLElement>('[data-doctor-carousel]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLImageElement>('[data-doctor-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-doctor-dot]'));
    if (slides.length < 2) return;
    const controls = Array.from(root.querySelectorAll<HTMLElement>('[data-doctor-controls]'));
    const status = root.querySelector<HTMLElement>('[data-doctor-status]');
    let cur = 0;
    root.classList.remove('snap-x', 'snap-mandatory', 'overflow-x-auto');
    root.classList.add('overflow-hidden');
    slides.forEach((slide) => slide.classList.add('absolute', 'inset-0'));
    controls.forEach((control) => { control.hidden = false; });

    const show = (nextIdx: number, announce = true) => {
      cur = (nextIdx + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-100', i === cur);
        s.classList.toggle('opacity-0', i !== cur);
        if (i === cur) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('w-6', i === cur);
        dot.classList.toggle('w-1.5', i !== cur);
        dot.classList.toggle('bg-white', i === cur);
        dot.classList.toggle('bg-white/55', i !== cur);
      });
      if (announce && status) status.textContent = `${cur + 1}/${slides.length} 사진: ${slides[cur]?.alt ?? ''}`;
    };
    show(0, false);
    root.querySelector('[data-doctor-prev]')?.addEventListener('click', () => show(cur - 1));
    root.querySelector('[data-doctor-next]')?.addEventListener('click', () => show(cur + 1));
  });

  // ── 모바일 스크롤 등장(2026-07-23 B-2·B-4) — 뷰포트 진입 시 순차 페이드인.
  // reduced-motion·IO 미지원이면 클래스를 켜지 않아 정적 표시(CSS는 vt-reveal-on 한정).
  {
    const els = Array.from(document.querySelectorAll<HTMLElement>('[data-vt-reveal]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (els.length && !reduce && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('vt-reveal-on');
      const io = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              obs.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
      );
      els.forEach((el) => io.observe(el));
    }
  }
</script>
